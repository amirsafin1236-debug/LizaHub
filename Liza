-- 3D-ПРЕВЬЮ (ViewportFrame): модель летает и вращается, можно крутить пальцем
---------------------------------------------------------------------
local previews = {}
local function makePreview3D(parent, size, getParts, getVer, bgKey)
	local holder = create("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, parent)
	local vp = create("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		Ambient = Color3.fromRGB(170, 170, 170),
		LightColor = WHITE,
		LightDirection = Vector3.new(-1, -1.5, -1),
	}, holder)
	bind(vp, "BackgroundColor3", bgKey or "Panel")
	corner(vp)
	local cam = create("Camera", { FieldOfView = 40 }, vp)
	vp.CurrentCamera = cam
	local hit = create("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 5 }, holder)

	local obj = { frame = holder, items = {}, ver = -1, yaw = 0.7, pitch = 0.2, t = 0, dragging = false, radius = 3 }

	function obj.rebuild()
		for _, it in ipairs(obj.items) do it.part:Destroy() end
		obj.items = {}
		local r = 1
		for i, pd in ipairs(getParts()) do
			local part = makePartInst(pd)
			part.Anchored = true
			local rel = CFrame.identity
			if i > 1 then rel = CFrame.new(pd.Offset) * rotCF(pd.Rot) end
			part.Parent = vp
			table.insert(obj.items, { part = part, rel = rel })
			r = math.max(r, rel.Position.Magnitude + pd.Size.Magnitude / 2)
		end
		obj.radius = r
		cam.CFrame = CFrame.lookAt(Vector3.new(0, r * 0.35, r * 2.6 + 1), Vector3.zero)
	end

	function obj.step(dt)
		local v = getVer()
		if v ~= obj.ver then
			obj.ver = v
			obj.rebuild()
		end
		obj.t += dt
		if not obj.dragging then
			obj.yaw += dt * 0.9
			obj.pitch += (0.2 - obj.pitch) * math.min(1, dt * 2)
		end
		local bob = math.sin(obj.t * 2) * obj.radius * 0.08
		local base = CFrame.new(0, bob, 0) * CFrame.Angles(obj.pitch, obj.yaw, 0)
		for _, it in ipairs(obj.items) do it.part.CFrame = base * it.rel end
	end

	-- вращение пальцем / мышью
	local last
	local cs = {}
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			obj.dragging = true
			last = i.Position
		end
	end)
	table.insert(cs, UIS.InputChanged:Connect(function(i)
		if obj.dragging and last and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - last
			last = i.Position
			obj.yaw += d.X * 0.012
			obj.pitch = math.clamp(obj.pitch + d.Y * 0.012, -1.3, 1.3)
		end
	end))
	table.insert(cs, UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			obj.dragging = false
		end
	end))
	holder.Destroying:Connect(function()
		for _, c in ipairs(cs) do c:Disconnect() end
	end)

	obj.rebuild()
	obj.ver = getVer()
	table.insert(previews, obj)
	return obj
end

track(RS.RenderStepped:Connect(function(dt)
	for i = #previews, 1, -1 do
		local o = previews[i]
		if o.frame.Parent == nil then
			table.remove(previews, i)
		else
			o.step(dt)
		end
	end
end))

