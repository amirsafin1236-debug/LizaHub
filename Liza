		if not clearArmed then
			clearArmed = true
			consoleAdd("Нажми «Очистить код» ещё раз, чтобы стереть весь скрипт", "warn")
			task.delay(3, function() clearArmed = false end)
			return
		end
		clearArmed = false
		box.Text = ""
		exF.Visible = false
	end, true)
end

