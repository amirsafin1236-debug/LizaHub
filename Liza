---------------------------------------------------------------------
-- СИСТЕМА ТЕМ (bind / onTheme)
---------------------------------------------------------------------
local bound = {}
local scale, scaleAnim, titleLabel

local function create(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local function bind(inst, prop, key, fn)
	table.insert(bound, { inst = inst, prop = prop, key = key, fn = fn })
	if key == "Accent" and prop == "BackgroundColor3" then
		table.insert(vipTargets, { inst = inst })
	end
	local v = Theme[key]
	if Vip.mode and key == "Accent" and prop == "BackgroundColor3" then v = WHITE end
	inst[prop] = fn and fn(v) or v
end

local function onTheme(inst, fn)
	table.insert(bound, { inst = inst, call = fn })
	fn()
end

local function applyTheme()
	for i = #bound, 1, -1 do
		local b = bound[i]
		if b.inst.Parent == nil then
			table.remove(bound, i)
		elseif b.call then
			b.call()
		else
			local v = Theme[b.key]
			if Vip.mode and b.key == "Accent" and b.prop == "BackgroundColor3" then v = WHITE end
			b.inst[b.prop] = b.fn and b.fn(v) or v
		end
	end
	scale.Scale = math.max(0.01, Theme.Scale * scaleAnim.Value)
	titleLabel.Text = Theme.Title
end

-- плавная смена темы
local themeTween = 0
local function tweenTheme(target)
	themeTween += 1
	local my = themeTween
	local from = snapshot()
	local start = os.clock()
	task.spawn(function()
		while my == themeTween do
			local a = Anim.theme
			local alpha = math.clamp((os.clock() - start) / math.max(a.time, 0.05), 0, 1)
			local e = math.clamp(TweenService:GetValue(alpha, a.style, a.dir), 0, 1)
			for _, k in ipairs(ColorKeys) do
				Theme[k] = from[k]:Lerp(target[k], e)
			end
			applyTheme()
			if alpha >= 1 then break end
			RS.Heartbeat:Wait()
		end
	end)
end

local function corner(inst)
	local c = create("UICorner", {}, inst)
	bind(c, "CornerRadius", "Corner", function(v) return UDim.new(0, v) end)
	return c
end

local function parseHex(s)
	s = tostring(s):gsub("%s", "")
	local ok, c = pcall(Color3.fromHex, s)
	if ok then return c end
	return nil
end

