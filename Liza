local function slider(page, sliderName, minValue, maxValue, initialValue, callback)
    local holder = make("Frame", {
        Size = UDim2.new(1, -2, 0, 48),
        BackgroundTransparency = 1,
        ZIndex = 4
    }, page)

    local value = initialValue

    make("TextLabel", {
        Size = UDim2.new(1, -55, 0, 20),
        BackgroundTransparency = 1,
        Text = sliderName,
        TextColor3 = Color3.fromRGB(230, 230, 235),
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4
    }, holder)

    local valueLabel = make("TextLabel", {
        Position = UDim2.new(1, -50, 0, 0),
        Size = UDim2.fromOffset(50, 20),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = ACCENT,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 4
    }, holder)

    local track = make("TextButton", {
        Position = UDim2.fromOffset(0, 29),
        Size = UDim2.new(1, 0, 0, 8),
        BackgroundColor3 = Color3.fromRGB(57, 58, 68),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 4
    }, holder)
    round(track, 5)

    local fill = make("Frame", {
        Name = "Fill",
        Size = UDim2.new((value - minValue) / (maxValue - minValue), 0, 1, 0),
        BackgroundColor3 = ACCENT,
        BorderSizePixel = 0,
        ZIndex = 5
    }, track)
    round(fill, 5)

    local dragging = false

    local function setFromX(x)
        local width = math.max(track.AbsoluteSize.X, 1)
        local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        value = math.floor(minValue + (maxValue - minValue) * alpha)
        valueLabel.Text = tostring(value)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        if callback then callback(value) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(input.Position.X)
        end
    end)

    local changedConnection = UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

