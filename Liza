local function C(r, g, b) return Color3.fromRGB(r, g, b) end
local function col(key, label, default) return { key = key, label = label, type = "color", default = default } end
local function num(key, label, min, max, default, step, hardMax)
	return { key = key, label = label, type = "number", min = min, max = max, default = default, step = step, hardMax = hardMax }
end
local function bool(key, label, default) return { key = key, label = label, type = "bool", default = default } end

local SkillDefs = {
	-- ДИСКОТЕКА
	{
		name = "Дискотека", kind = "toggle",
		params = {
			col("c1", "Цвет дискотеки 1", C(255, 0, 120)),
			col("c2", "Цвет дискотеки 2", C(0, 200, 255)),
			col("c3", "Цвет дискотеки 3", C(255, 230, 0)),
			num("cspeed", "Скорость смены цвета", 0, 5, 0.8, 0.1, 30),
			num("spin", "Скорость вращения", 0, 1500, 300, 10, 10000),
