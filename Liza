local function runToolAction(spec)
	local root = getRoot()
	if not root then return end
	if spec.Action == "Скрипт" then
		runScript(spec.Script or "", false)
	else
		local f = Actions[spec.Action]
		if f then f(root, spec) end
	end
end

local function buildTool(spec)
	local tool = create("Tool", {
		Name = spec.Name,
		ToolTip = spec.Name,
		RequiresHandle = true,
		CanBeDropped = false,
	}, nil)
	tool:SetAttribute("LizaId", spec.Id)
	local handle
	for i, pd in ipairs(spec.Parts) do
		local part = makePartInst(pd)
		if i == 1 then
			part.Name = "Handle"
			part.Parent = tool
			handle = part
		else
			part.Name = "Part" .. i
			part.Massless = true
			part.CFrame = handle.CFrame * CFrame.new(pd.Offset) * rotCF(pd.Rot)
			part.Parent = tool
			local w = Instance.new("WeldConstraint")
			w.Part0 = handle
			w.Part1 = part
			w.Parent = handle
		end
	end
	tool.Activated:Connect(function() runToolAction(spec) end)
	return tool
end

local function removeToolById(id)
	local function scan(c)
		if not c then return end
		for _, t in ipairs(c:GetChildren()) do
			if t:IsA("Tool") and t:GetAttribute("LizaId") == id then t:Destroy() end
		end
	end
	scan(player:FindFirstChildOfClass("Backpack"))
	scan(player.Character)
end

local function giveTool(spec)
	local bp = player:FindFirstChildOfClass("Backpack")
	if not bp then return end
	removeToolById(spec.Id)
	buildTool(spec).Parent = bp
end

