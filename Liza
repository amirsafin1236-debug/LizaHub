	baseBtn.Position = UDim2.fromOffset(12, 182)
	baseBtn.Size = UDim2.new(1, -24, 0, 34)

	local off = button(p, "Выключить VIP", function() vipSet(nil) end, true)
	off.Position = UDim2.fromOffset(12, 224)
	off.Size = UDim2.new(1, -24, 0, 34)
end

