	corner(box)

	local bar = create("Frame", {
		Position = UDim2.new(0, 10, 0, 38),
		Size = UDim2.new(1, -20, 0, 8),
		BorderSizePixel = 0,
	}, row)
	bind(bar, "BackgroundColor3", "Bg")
