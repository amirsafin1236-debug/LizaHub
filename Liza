		Position = UDim2.fromOffset(10, 2),
		Size = UDim2.fromOffset(120, 20),
		Text = "Консоль",
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, con)
	bind(ch, "TextColor3", "Accent")
	bind(ch, "Font", "Font")
	local clr = create("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 3),
		Size = UDim2.fromOffset(74, 20),
		Text = "Очистить",
		TextSize = 13,
		BorderSizePixel = 0,
		AutoButtonColor = false,
	}, con)
	bind(clr, "BackgroundColor3", "Bg")
	bind(clr, "TextColor3", "Text")
	bind(clr, "Font", "Font")
	corner(clr)
	local cs = create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(8, 26),
