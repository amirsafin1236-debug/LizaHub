local menuOpen = true

local function hideMenu()
    if not menuOpen then return end
    menuOpen = false
    tween(scaleObject, 0.12, {Scale = scaleObject.Scale * 0.9})

    task.delay(0.13, function()
        if not menuOpen then
            main.Visible = false
            reopenButton.Visible = true
        end
    end)
end

local function showMenu()
    if menuOpen then return end
    menuOpen = true
    reopenButton.Visible = false
    main.Visible = true
    fitScreen()

    local targetScale = scaleObject.Scale
    scaleObject.Scale = targetScale * 0.9
    tween(scaleObject, 0.16, {Scale = targetScale})
end

