local openAnimEditor
openAnimEditor = function(id)
	id = id or AnimOrder[1]
	local a = Anim[id]
	local p = showPopup(450, 288, "Редактор анимаций")
	local left, sc, sticky = splitLayout(p, 160, 36)

	local stage = create("Frame", { Size = UDim2.fromOffset(160, 160), BorderSizePixel = 0, ClipsDescendants = true }, left)
	bind(stage, "BackgroundColor3", "Panel")
	corner(stage)
	local demo = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(56, 56),
		BorderSizePixel = 0,
	}, stage)
	bind(demo, "BackgroundColor3", "Accent")
	create("UICorner", { CornerRadius = UDim.new(0, 12) }, demo)
	local ds = create("UIScale", { Scale = 1 }, demo)

	local cap = create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 166),
		Size = UDim2.new(1, 0, 0, 44),
		TextWrapped = true,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, left)
	bind(cap, "TextColor3", "Text")
	bind(cap, "Font", "Font")
	local function refreshCap()
		cap.Text = a.name .. "\n" .. a.style.Name .. " · " .. a.dir.Name .. " · " .. string.format("%.2f", a.time) .. " с"
	end
	refreshCap()

	local function play()
		if not demo.Parent then return end
		ds.Scale = 1
		demo.Position = UDim2.fromScale(0.5, 0.5)
		demo.BackgroundColor3 = accentBg()
		local k = a.kind
		if k == "scaleIn" then
			ds.Scale = 0.01
			tw(ds, a.time, { Scale = 1 }, a.style, a.dir)
		elseif k == "scaleOut" then
			tw(ds, a.time, { Scale = 0.01 }, a.style, a.dir)
		elseif k == "slide" then
			demo.Position = UDim2.fromScale(0.2, 0.5)
			tw(demo, a.time, { Position = UDim2.fromScale(0.8, 0.5) }, a.style, a.dir)
		elseif k == "knob" then
			demo.Position = UDim2.fromScale(0.3, 0.5)
			tw(demo, a.time, { Position = UDim2.fromScale(0.7, 0.5) }, a.style, a.dir)
		elseif k == "color" then
			demo.BackgroundColor3 = Theme.Panel
			tw(demo, a.time, { BackgroundColor3 = Theme.Accent }, a.style, a.dir)
		end
	end

	-- кнопка "Проиграть" — СВЕРХУ, всегда на виду (не прокручивается)
	button(sticky, "▶  Проиграть", play)

	local items = {}
	for _, k in ipairs(AnimOrder) do
		table.insert(items, { text = Anim[k].name, id = k, selected = (k == id) })
	end
	button(sc, "Анимация: " .. a.name, function()
		openList("Анимации", items, function(it) openAnimEditor(it.id) end)
	end)

	button(sc, "Твин: " .. a.style.Name, function()
		local styles = {}
		for _, s in ipairs(Enum.EasingStyle:GetEnumItems()) do
			table.insert(styles, { text = s.Name, style = s, selected = (a.style == s) })
		end
		openList("Твин (стиль)", styles, function(it)
			a.style = it.style
			openAnimEditor(id)
		end)
	end)

	cycle(sc, "Направление", { "In", "Out", "InOut" }, a.dir.Name, function(v)
		a.dir = Enum.EasingDirection[v]
		refreshCap()
		play()
	end)

	slider(sc, "Длительность (сек)", 0.05, 2, a.time, 0.05, 5, function(v)
		a.time = v
		refreshCap()
	end)

	button(sc, "Сбросить эту анимацию", function()
		local d = AnimDefaults[id]
		a.style, a.dir, a.time = d.style, d.dir, d.time
		openAnimEditor(id)
	end, true)

	task.delay(0.35, play)
end

