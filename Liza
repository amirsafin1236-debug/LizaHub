local controls
task.spawn(function()
	local ps = player:WaitForChild("PlayerScripts", 10)
	local pm = ps and ps:WaitForChild("PlayerModule", 10)
	if pm then
		local ok, res = pcall(function() return require(pm):GetControls() end)
		if ok then controls = res end
	end
end)

local flyConn, bv, bg
local flyTgl

local function stopFly()
	State.Flying = false
	if flyConn then flyConn:Disconnect() flyConn = nil end
	if bv then bv:Destroy() bv = nil end
	if bg then bg:Destroy() bg = nil end
	local hum = getHum()
	if hum then
		hum.PlatformStand = false
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

local function getMoveVector()
	if controls then
		local ok, mv = pcall(function() return controls:GetMoveVector() end)
		if ok and mv then return mv end
	end
	local x, z = 0, 0
	if UIS:IsKeyDown(Enum.KeyCode.D) then x += 1 end
	if UIS:IsKeyDown(Enum.KeyCode.A) then x -= 1 end
	if UIS:IsKeyDown(Enum.KeyCode.S) then z += 1 end
	if UIS:IsKeyDown(Enum.KeyCode.W) then z -= 1 end
	return Vector3.new(x, 0, z)
end

local function startFly()
	local root, hum = getRoot(), getHum()
	if not root or not hum then return false end
	stopFly()
	State.Flying = true
	hum.PlatformStand = true

	bv = create("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero }, root)
	bg = create("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 1e4, D = 600, CFrame = root.CFrame }, root)

	local vel = Vector3.zero
	flyConn = RS.RenderStepped:Connect(function(dt)
		if not root.Parent then
			stopFly()
			if flyTgl then flyTgl(false) end
			return
		end
		local cam = workspace.CurrentCamera
		local mv = getMoveVector()
		-- летим туда, куда смотрит камера (вверх/вниз тоже)
		local dir = cam.CFrame:VectorToWorldSpace(Vector3.new(mv.X, 0, mv.Z))

		if UIS:GetFocusedTextBox() == nil then
			if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then dir += Vector3.new(0, 1, 0) end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) then dir -= Vector3.new(0, 1, 0) end
		end
		if dir.Magnitude > 1 then dir = dir.Unit end

		vel = vel:Lerp(dir * State.FlySpeed, 1 - math.exp(-dt * 8))
		bv.Velocity = vel

		local look = cam.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.01 then flat = root.CFrame.LookVector end
		local lean = math.rad(35) * math.clamp(vel.Magnitude / math.max(State.FlySpeed, 1), 0, 1)
		bg.CFrame = CFrame.lookAt(root.Position, root.Position + flat) * CFrame.Angles(-lean, 0, 0)
	end)
	return true
end

local function toggleFly()
	if State.Flying then stopFly() else startFly() end
	if flyTgl then flyTgl(State.Flying) end
end

track(player.CharacterAdded:Connect(function()
	if State.Flying then
		stopFly()
		if flyTgl then flyTgl(false) end
	end
end))

