local function applyPaletteColor()
	local color = Color3.fromHSV(paletteHue, paletteSat, paletteVal)
	palette.BackgroundColor3 = Color3.fromHSV(paletteHue, 1, 1)
	paletteCursor.Position = UDim2.fromScale(paletteSat, 1 - paletteVal)
	colorPreview.BackgroundColor3 = color
	updateAccent(color)
end

local function setPaletteFromPosition(x, y, hueOnly)
	if hueOnly then
		paletteHue = math.clamp((x - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 1)
	else
		paletteSat = math.clamp((x - palette.AbsolutePosition.X) / math.max(palette.AbsoluteSize.X, 1), 0, 1)
		paletteVal = 1 - math.clamp((y - palette.AbsolutePosition.Y) / math.max(palette.AbsoluteSize.Y, 1), 0, 1)
	end
	applyPaletteColor()
end

