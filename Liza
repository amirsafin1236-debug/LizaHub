local function rotCF(r) return CFrame.Angles(math.rad(r.X), math.rad(r.Y), math.rad(r.Z)) end

local function pdata(shape, color, size, offset, rot, mat, transp)
	return {
		Shape = shape or "Блок",
		Color = color or RGB(200, 200, 200),
		Size = size or Vector3.new(1, 1, 1),
		Offset = offset or Vector3.zero,
		Rot = rot or Vector3.zero,
		Material = mat or "Пластик",
		Transparency = transp or 0,
	}
end
local function copyParts(list)
	local t = {}
	for i, p in ipairs(list) do
		t[i] = pdata(p.Shape, p.Color, p.Size, p.Offset, p.Rot, p.Material, p.Transparency)
	end
	return t
end

local function makePartInst(pd)
	local part
	if pd.Shape == "Клин" then
		part = Instance.new("WedgePart")
	else
		part = Instance.new("Part")
		if pd.Shape == "Шар" then part.Shape = Enum.PartType.Ball
		elseif pd.Shape == "Цилиндр" then part.Shape = Enum.PartType.Cylinder end
	end
	part.Size = pd.Size
	part.Color = pd.Color
	part.Material = MatMap[pd.Material] or Enum.Material.SmoothPlastic
	part.Transparency = pd.Transparency or 0
	part.CanCollide = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

