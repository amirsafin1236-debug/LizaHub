local function stopFly()
    flyOn = false
    flyingUp, flyingDown = false, false
    mobile.Visible = false

    if flyConn then flyConn:Disconnect() flyConn = nil end
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end

    local _, hum = getChar()
    if hum then hum.PlatformStand = false end
end

local function startFly()
    stopFly()

    local _, hum, root = getChar()
    if not hum or not root then return end

    flyOn = true
    mobile.Visible = true

    bv = Instance.new("BodyVelocity")
    bv.Name = "LizaHubFlyVelocity"
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.P = 1e4
    bv.Velocity = Vector3.zero
    bv.Parent = root

    bg = Instance.new("BodyGyro")
    bg.Name = "LizaHubFlyGyro"
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.P = 1e4
    bg.Parent = root

    flyConn = RunService.RenderStepped:Connect(function()
        local _, h, r = getChar()
        if not flyOn or not h or not r or not bv or not bv.Parent then
            stopFly()
            return
        end

        local cam = workspace.CurrentCamera
        local move = h.MoveDirection * flySpeed
        local y = 0

        if flyingUp or UIS:IsKeyDown(Enum.KeyCode.Space) then
            y = flySpeed
        elseif flyingDown or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            y = -flySpeed
        end

        bv.Velocity = Vector3.new(move.X, y, move.Z)
        bg.CFrame = cam.CFrame
    end)
end

local function toggleFly()
    if flyOn then stopFly() else startFly() end
end

local function applyStats()
    local _, hum = getChar()
    if not hum then return end

    if keepSpeed then hum.WalkSpeed = speedValue end
    if keepJump then
        hum.UseJumpPower = true
        hum.JumpPower = jumpValue
    end
end

statConn = RunService.Heartbeat:Connect(function()
    if keepSpeed or keepJump then applyStats() end
end)

player.CharacterAdded:Connect(function()
    task.wait(1)
    applyStats()
    if flyOn then stopFly() end
end)

-- Locally-created tools
local function makeTool(name, color, isOrb)
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not backpack then return end

    local tool = Instance.new("Tool")
    tool.Name = name
    tool.RequiresHandle = true
    tool.CanBeDropped = false

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = isOrb and Vector3.new(1.2, 1.2, 1.2)
        or Vector3.new(1, 1, 1)
    handle.Shape = isOrb and Enum.PartType.Ball
        or Enum.PartType.Block
    handle.Color = color
    handle.Material = Enum.Material.Neon
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool

    tool.Parent = backpack
end

local function showTab(name)
    selectedTab = name
    clearContent()

    -- Fade content in
    content.CanvasPosition = Vector2.zero
    content.Position = UDim2.fromOffset(143, 61)
    tween(content, 0.18, {
        Position = UDim2.fromOffset(143, 56)
    })

    if name == "Player" then
        label("PLAYER  /  CHARACTER")

        local sp = textbox("WalkSpeed (0–300)", "32")
        button("Apply Speed", function()
            local n = tonumber(sp.Text)
            if n and n >= 0 and n <= 300 then
                speedValue = n
                keepSpeed = true
                applyStats()
            end
        end)

        button("Reset Speed", function()
            speedValue = 16
            keepSpeed = true
            applyStats()
        end)

        local jp = textbox("JumpPower (0–300)", "100")
        button("Apply Jump", function()
            local n = tonumber(jp.Text)
            if n and n >= 0 and n <= 300 then
                jumpValue = n
                keepJump = true
                applyStats()
            end
        end)

        button("Reset Jump", function()
            jumpValue = 50
            keepJump = true
            applyStats()
        end)

        button("Heal Character", function()
            local _, hum = getChar()
            if hum then hum.Health = hum.MaxHealth end
        end)

        button("Reset Character", function()
            local _, hum = getChar()
            if hum then hum.Health = 0 end
        end)

    elseif name == "Movement" then
        label("MOVEMENT  /  FLIGHT")

        button("Toggle Fly", toggleFly)

        local fs = textbox("Flight speed", "55")
        button("Apply Flight Speed", function()
            local n = tonumber(fs.Text)
            if n and n >= 5 and n <= 250 then
                flySpeed = n
            end
        end)

        label("PHONE: hold UP / DOWN")
        label("PC: Space up / Ctrl down")

    elseif name == "Items" then
        label("ITEM CREATOR")

        local itemName = textbox("Item name", "MyTool")

        colorButton("CHOOSE ITEM COLOR", itemColor, function(col)
            itemColor = col
        end)

        button("Create Custom Tool", function()
            local n = itemName.Text
            if n == "" then n = "MyTool" end
            makeTool(n, itemColor, false)
        end)

        button("Create Neon Orb", function()
            makeTool("Liza Orb", itemColor, true)
        end)

        label("LOCAL ITEMS — YOUR CLIENT ONLY")

    elseif name == "Fun" then
        label("FUN  /  EFFECTS")

        button("Day Lighting", function()
            Lighting.ClockTime = 14
            Lighting.Brightness = 2
        end)

        button("Night Lighting", function()
            Lighting.ClockTime = 0
            Lighting.Brightness = 1
        end)

        button("Reset Lighting", function()
            Lighting.ClockTime = savedLighting.ClockTime
            Lighting.Brightness = savedLighting.Brightness
            Lighting.GlobalShadows = savedLighting.GlobalShadows
        end)

        button("Add Sparkles", function()
            local _, _, root = getChar()
            if root and not root:FindFirstChild("LizaSparkles") then
                local s = Instance.new("Sparkles")
                s.Name = "LizaSparkles"
                s.SparkleColor = accent
                s.Parent = root
            end
        end)

        button("Remove Sparkles", function()
            local _, _, root = getChar()
            if root and root:FindFirstChild("LizaSparkles") then
                root.LizaSparkles:Destroy()
            end
        end)

    elseif name == "Settings" then
        label("SETTINGS  /  CUSTOMIZATION")

        local nameBox = textbox("Menu name", menuTitle)
        button("Apply Menu Name", function()
            if nameBox.Text ~= "" then
                menuTitle = nameBox.Text
                title.Text = "✦ " .. menuTitle
                reopen.Text = "✦ " .. menuTitle
            end
        end)

        colorButton("MENU COLOR", accent, function(col)
            accent = col
            mainStroke.Color = col
            studioStroke.Color = col
            title.TextColor3 = WHITE
            accentLine.BackgroundColor3 = col
            close.BackgroundColor3 = col
            content.ScrollBarImageColor3 = col
            studioTitle.TextColor3 = col
            outline(reopen, col)

            for _, obj in ipairs(sidebar:GetChildren()) do
                if obj:IsA("TextButton") then
                    -- Active tab keeps its own accent.
                    if obj.Name == selectedTab then
                        obj.BackgroundColor3 = col
                    end
                end
            end

            for _, obj in ipairs(mobile:GetChildren()) do
                if obj:IsA("TextButton") then
                    obj.BackgroundColor3 = col
                end
            end
        end)

        button("Background: Dark", function()
            main.BackgroundColor3 = BG
            sidebar.BackgroundColor3 = PANEL
            header.BackgroundColor3 = PANEL
        end)

        button("Background: Lighter", function()
            main.BackgroundColor3 = Color3.fromRGB(60, 42, 33)
            sidebar.BackgroundColor3 = Color3.fromRGB(69, 48, 37)
            header.BackgroundColor3 = Color3.fromRGB(69, 48, 37)
        end)

        button("Reset Menu Position", function()
            tween(main, 0.25, {
                Position = UDim2.new(0.5, -245, 0.5, -187)
            }, Enum.EasingStyle.Back)
        end)
    end
end

local tabs = {"Player", "Movement", "Items", "Fun", "Settings"}

for i, name in ipairs(tabs) do
    local b = make("TextButton", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 39),
        BackgroundColor3 = BG,
        Text = name,
        TextColor3 = WHITE,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        LayoutOrder = i,
        AutoButtonColor = false
    }, sidebar)

    round(b, 8)

    b.MouseEnter:Connect(function()
        if selectedTab ~= name then
            tween(b, 0.12, {BackgroundColor3 = Color3.fromRGB(67, 43, 31)})
        end
    end)

    b.MouseLeave:Connect(function()
        if selectedTab ~= name then
            tween(b, 0.12, {BackgroundColor3 = BG})
        end
    end)

    b.Activated:Connect(function()
        selectedTab = name

        for _, other in ipairs(sidebar:GetChildren()) do
            if other:IsA("TextButton") then
                tween(other, 0.12, {
                    BackgroundColor3 = other == b and accent or BG
                })
            end
        end

        showTab(name)
    end)
end

UIS.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.RightShift then
        if overlay.Visible then
            closeStudio()
        elseif main.Visible then
            hideMenu()
        else
            showMenu()
        end
    end
end)

showTab("Player")

for _, obj in ipairs(sidebar:GetChildren()) do
    if obj:IsA("TextButton") and obj.Name == "Player" then
        obj.BackgroundColor3 = accent
    end
end

