		Font = Enum.Font.Code,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "",
	}, cs)
	bind(clabel, "TextColor3", "Text")

	local function esc(s)
		return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
	end
	local function showErrLine(ln)
		errBar.Position = UDim2.fromOffset(0, 6 + (ln - 1) * lineH)
		errBar.Visible = true
	end
	consoleRefresh = function()
		if not clabel.Parent then return end
		local lines = {}
		for _, m in ipairs(ConsoleLog) do
			local colr
			if m.kind == "error" then colr = "FF6B6B"
			elseif m.kind == "warn" then colr = "FFB84D"
			elseif m.kind == "info" then colr = "8FA0B3"
			else colr = Theme.Text:ToHex() end
			lines[#lines + 1] = '<font color="#' .. colr .. '">' .. esc(m.text) .. "</font>"
		end
		clabel.Text = table.concat(lines, "\n")
		task.defer(function()
			if cs.Parent then cs.CanvasPosition = Vector2.new(0, 1e6) end
		end)
		local last = ConsoleLog[#ConsoleLog]
		if last and last.kind == "error" then
			local ln = tonumber(last.text:match("строка (%d+)"))
			if ln then showErrLine(ln) end
		end
	end
	local clearArmed = false
	clr.Activated:Connect(function()
		ConsoleLog = {}
		consoleRefresh()
	end)
	if #ConsoleLog == 0 then
		for _, l in ipairs(HelpLines) do consoleAdd(l, "info") end
	else
		consoleRefresh()
	end

	-- ===== запуск / сохранение / закрытие =====
	local currentRun
	local function doRun()
		if currentRun then currentRun.ctrl.stopFlag = true end
		errBar.Visible = false
		consoleAdd("▶ запуск…", "info")
		currentRun = runScript(box.Text, true)
	end
	local closing = false
	local function save()
		if onSave then onSave(box.Text) end
	end
	local function close()
		if closing then return end
		closing = true
		save()
		scriptEditorOpen = false
		consoleRefresh = nil
		local t = tw(root, 0.3, { Position = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			sg:Destroy()
			if scriptGui == sg then scriptGui = nil end
		end)
	end

	-- ===== верхняя панель =====
