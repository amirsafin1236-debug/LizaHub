local function stopFly()
    flying = false
    verticalDirection = 0
    mobileFlyFrame.Visible = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end

    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end
end

local function startFly()
    if flying then
        stopFly()
        return
    end

    local root = getRoot()
    local hum = getHumanoid()
    if not root or not hum then return end

    flying = true
    mobileFlyFrame.Visible = UIS.TouchEnabled

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Name = "LizaHubFlyVelocity"
    bodyVelocity.MaxForce = Vector3.new(1e7, 1e7, 1e7)
    bodyVelocity.P = 1e4
    bodyVelocity.Velocity = Vector3.zero
    bodyVelocity.Parent = root

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.Name = "LizaHubFlyGyro"
    bodyGyro.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
    bodyGyro.P = 1e4
    bodyGyro.CFrame = root.CFrame
    bodyGyro.Parent = root

    flyConnection = RunService.RenderStepped:Connect(function()
        local currentRoot = getRoot()
        local camera = workspace.CurrentCamera

        if not flying or not currentRoot or not camera or not bodyVelocity or not bodyGyro then
            stopFly()
            return
        end

        local direction = Vector3.zero

        if UIS.TouchEnabled then
            local currentHumanoid = getHumanoid()
            if currentHumanoid then direction += currentHumanoid.MoveDirection end
        else
            if UIS:IsKeyDown(Enum.KeyCode.W) then direction += camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then direction -= camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then direction -= camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then direction += camera.CFrame.RightVector end
        end

        local up = UIS:IsKeyDown(Enum.KeyCode.Space) and 1 or 0
        local down = UIS:IsKeyDown(Enum.KeyCode.LeftControl) and 1 or 0
        direction += Vector3.new(0, up - down + verticalDirection, 0)

        if direction.Magnitude > 0 then direction = direction.Unit end
        bodyVelocity.Velocity = direction * flySpeed
        bodyGyro.CFrame = camera.CFrame
    end)
end

