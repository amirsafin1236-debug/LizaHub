---------------------------------------------------------------------
track(UIS.InputBegan:Connect(function(i, gp)
	if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
	if rebinding then
		rebinding = false
		if i.KeyCode ~= Enum.KeyCode.Unknown then Theme.ToggleKey = i.KeyCode end
		applyTheme()
		return
	end
	if gp then return end
	if i.KeyCode == Theme.ToggleKey then
		setOpen(not isOpen)
	elseif i.KeyCode == Enum.KeyCode.F then
		toggleFly()
	end
end))

applyTheme()

