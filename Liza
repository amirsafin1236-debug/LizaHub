---------------------------------------------------------------------
-- BUILDING + КРЕДИТЫ (мини-игра Claude)
---------------------------------------------------------------------
do
	local MAXP = 500
	local B = {
		Mode = "Поставить", Shape = "Блок",
		Mat = Enum.Material.SmoothPlastic, MatName = "Пластик",
		Color = Color3.fromRGB(255, 140, 26), Size = Vector3.new(4, 1, 4),
		Transparency = 0, Reflect = 0, Rot = 0,
		Grid = true, GridSize = 1,
		Anchored = true, Collide = true, Light = false, Ghost = true,
		Ver = 0,
	}
	local function touch() B.Ver += 1 end

	local Mats = {}
	for _, m in ipairs({
		{ "Пластик", "SmoothPlastic" }, { "Пластик (зерно)", "Plastic" }, { "Дерево", "Wood" },
		{ "Доски", "WoodPlanks" }, { "Кирпич", "Brick" }, { "Бетон", "Concrete" },
		{ "Камень", "Slate" }, { "Булыжник", "Cobblestone" }, { "Гранит", "Granite" },
		{ "Мрамор", "Marble" }, { "Металл", "Metal" }, { "Ржавчина", "CorrodedMetal" },
		{ "Рифлёный металл", "DiamondPlate" }, { "Фольга", "Foil" }, { "Стекло", "Glass" },
		{ "Лёд", "Ice" }, { "Неон", "Neon" }, { "Трава", "Grass" },
		{ "Песок", "Sand" }, { "Ткань", "Fabric" }, { "Снег", "Snow" },
	}) do
		local ok, e = pcall(function() return Enum.Material[m[2]] end)
		if ok and e then table.insert(Mats, { m[1], e }) end
	end
	local function matNameOf(e)
		for _, m in ipairs(Mats) do
			if m[2] == e then return m[1] end
		end
		return e.Name
	end

	local folder = create("Folder", { Name = "LizaBuild" }, workspace)
	local History, tool, ghost, ghostVer = {}, nil, nil, -1
	local given = false
	local colorSw, matBtn, setSizeBox, setTr, setRf, setRot, countL, giveBtn, ctrl
	local giveHammer

	local function curSize()
		local s = B.Size
		if B.Shape == "Шар" then
			local m = math.max(s.X, s.Y, s.Z)
			return Vector3.new(m, m, m)
		end
		return s
	end
	local function fmtSize(s) return string.format("%g %g %g", s.X, s.Y, s.Z) end
	local function updCount()
		if countL then countL.Text = "Построено: " .. #folder:GetChildren() .. " / " .. MAXP end
	end
	local function push(h)
		table.insert(History, h)
		if #History > 60 then table.remove(History, 1) end
	end
	local function sync()
		if colorSw then colorSw.BackgroundColor3 = B.Color end
		if matBtn then matBtn.Text = "Материал: " .. B.MatName end
		if setSizeBox then setSizeBox(fmtSize(B.Size)) end
		if setTr then setTr(B.Transparency) end
		if setRf then setRf(B.Reflect) end
		if setRot then setRot(B.Rot) end
		touch()
	end

	-- ===== луч, позиция, сетка =====
	local function castMouse()
		local cam = workspace.CurrentCamera
		local ray = cam:ScreenPointToRay(mouse.X, mouse.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ex = {}
		if player.Character then table.insert(ex, player.Character) end
		if ghost then table.insert(ex, ghost) end
		params.FilterDescendantsInstances = ex
		return workspace:Raycast(ray.Origin, ray.Direction * 500, params)
	end
	local function halfExt(cf, s)
		local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
		return Vector3.new(
			math.abs(r.X) * s.X + math.abs(u.X) * s.Y + math.abs(l.X) * s.Z,
			math.abs(r.Y) * s.X + math.abs(u.Y) * s.Y + math.abs(l.Y) * s.Z,
			math.abs(r.Z) * s.X + math.abs(u.Z) * s.Y + math.abs(l.Z) * s.Z
		) / 2
	end
	local function snap(v, g) return math.floor(v / g + 0.5) * g end
	local function targetCF(res)
		local rot = CFrame.Angles(0, math.rad(B.Rot), 0)
		local half = halfExt(rot, curSize())
		local n = res.Normal
		local off = math.abs(n.X) * half.X + math.abs(n.Y) * half.Y + math.abs(n.Z) * half.Z
		local pos = res.Position + n * off
		if B.Grid then
			local g = math.max(B.GridSize, 0.05)
			pos = Vector3.new(snap(pos.X, g), snap(pos.Y, g), snap(pos.Z, g))
		end
		return CFrame.new(pos) * rot
	end

	-- ===== действия молотка =====
	local function place(res)
		if #folder:GetChildren() >= MAXP then
			toast("Лимит " .. MAXP .. " партов", true)
			return
		end
		local part = makePartInst(pdata(B.Shape, B.Color, curSize(), nil, nil, "Пластик", B.Transparency))
		part.Name = "Block"
		part.Material = B.Mat
		part.Reflectance = B.Reflect
		part.Anchored = B.Anchored
		part.CanCollide = B.Collide
		part.CastShadow = true
		part.CFrame = targetCF(res)
		if B.Light then
			create("PointLight", { Color = B.Color, Brightness = 2, Range = 16, Shadows = false }, part)
		end
		part.Parent = folder
		push({ t = "place", part = part })
		updCount()
	end

	local function onClick()
		local res = castMouse()
		if not res then return end
		if B.Mode == "Поставить" then
			place(res)
			return
		end
		local part = res.Instance
		if not part:IsDescendantOf(folder) then
			toast("Это не твой блок", true)
			return
		end
		if B.Mode == "Удалить" then
			push({ t = "delete", clone = part:Clone() })
			part:Destroy()
			updCount()
		elseif B.Mode == "Покрасить" then
			push({ t = "paint", part = part, c = part.Color, m = part.Material, tr = part.Transparency, rf = part.Reflectance })
			part.Color = B.Color
			part.Material = B.Mat
			part.Transparency = B.Transparency
			part.Reflectance = B.Reflect
			local l = part:FindFirstChildOfClass("PointLight")
			if l then l.Color = B.Color end
		elseif B.Mode == "Пипетка" then
			B.Color, B.Mat, B.MatName = part.Color, part.Material, matNameOf(part.Material)
			B.Transparency, B.Reflect, B.Size = part.Transparency, part.Reflectance, part.Size
			sync()
			toast("Свойства скопированы")
		end
	end

	local function undo()
		local h = table.remove(History)
		if not h then toast("Нечего отменять") return end
		if h.t == "place" then
			if h.part.Parent then h.part:Destroy() end
		elseif h.t == "delete" then
			h.clone.Parent = folder
		elseif h.t == "paint" and h.part.Parent then
			h.part.Color, h.part.Material = h.c, h.m
			h.part.Transparency, h.part.Reflectance = h.tr, h.rf
		end
		updCount()
	end

	local function rotate90()
		B.Rot = (B.Rot + 90) % 360
		if setRot then setRot(B.Rot) end
		touch()
	end

	-- ===== молоток =====
	local function V(x, y, z) return Vector3.new(x, y, z) end
	local HAMMER = {
		Id = "LizaHammer", Name = "Молоток", Action = "Нет",
		Parts = {
			pdata("Блок", RGB(110, 70, 40), V(0.4, 0.4, 2.6), nil, nil, "Дерево"),
			pdata("Блок", RGB(140, 140, 150), V(1.7, 1.1, 1.1), V(0, 0, -1.5), nil, "Металл"),
			pdata("Блок", RGB(255, 140, 26), V(0.25, 1.2, 1.2), V(0.95, 0, -1.5), nil, "Неон"),
			pdata("Блок", RGB(255, 140, 26), V(0.25, 1.2, 1.2), V(-0.95, 0, -1.5), nil, "Неон"),
		},
	}
	local function equipped() return tool and tool.Parent == player.Character end

	giveHammer = function(silent)
		local bp = player:FindFirstChildOfClass("Backpack")
		if not bp then return end
		removeToolById(HAMMER.Id)
		tool = buildTool(HAMMER)
		tool.Activated:Connect(onClick)
		tool.Parent = bp
		given = true
		ctrl.Visible = true
		giveBtn.Text = "Give — молоток ещё раз"
		updCount()
		if not silent then toast("Молоток в рюкзаке!") end
	end

	-- призрак-превью
	local function rebuildGhost()
		if ghost then ghost:Destroy() ghost = nil end
		ghost = makePartInst(pdata(B.Shape, B.Color, curSize(), nil, nil, "Пластик", math.max(0.55, B.Transparency)))
		ghost.Name = "LizaGhost"
		ghost.Anchored, ghost.CanCollide, ghost.CanQuery, ghost.CanTouch, ghost.CastShadow = true, false, false, false, false
		ghost.Material = B.Mat
		ghostVer = B.Ver
	end
	track(RS.RenderStepped:Connect(function()
		if not (equipped() and B.Ghost and B.Mode == "Поставить") then
			if ghost and ghost.Parent then ghost.Parent = nil end
			return
		end
		if not ghost or ghostVer ~= B.Ver then rebuildGhost() end
		local res = castMouse()
		if res then
			ghost.CFrame = targetCF(res)
			ghost.Parent = workspace
		else
			ghost.Parent = nil
		end
	end))

	track(UIS.InputBegan:Connect(function(i, gp)
		if gp or i.UserInputType ~= Enum.UserInputType.Keyboard or not equipped() then return end
		if i.KeyCode == Enum.KeyCode.R then rotate90()
		elseif i.KeyCode == Enum.KeyCode.Z then undo() end
	end))

	track(player.CharacterAdded:Connect(function()
		if not given then return end
		task.wait(0.7)
		giveHammer(true)
	end))

	-- чистка при «Выгрузить панель»
	table.insert(conns, { Disconnect = function()
		if ghost then ghost:Destroy() end
		removeToolById(HAMMER.Id)
		folder:Destroy()
	end })

	-- ===== ВКЛАДКА BUILDING =====
	local pBuild = addTab("Building")

	giveBtn = button(pBuild, "Give — получить молоток", function() giveHammer(false) end)
	giveBtn.LayoutOrder = 1
	local hintL = note(pBuild, "Нажми Give, и появятся настройки стройки. Блоки видишь только ты.")
	hintL.LayoutOrder = 2

