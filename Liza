	},

	-- НЕОНОВАЯ АУРА
	{
		name = "Неоновая аура", kind = "toggle",
		params = {
			bool("rainbow", "Радуга", false),
			col("c1", "Цвет заливки", C(255, 140, 26)),
			col("c2", "Цвет контура", C(255, 255, 255)),
			num("fill", "Прозрачность заливки", 0, 1, 0.5, 0.05, 1),
			num("pulse", "Скорость пульсации", 0, 5, 1.5, 0.1, 30),
		},
		start = function(cfg)
			local char = player.Character
			if not char then return nil end
			local hl = create("Highlight", {
				Name = "LizaAura", Adornee = char, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			}, char)
			local conn = RS.Heartbeat:Connect(function()
				local t = os.clock()
				local pulse = 0.5 + 0.5 * math.sin(t * cfg.pulse * math.pi * 2)
				if cfg.rainbow then
					hl.FillColor = Color3.fromHSV((t * 0.3) % 1, 0.9, 1)
					hl.OutlineColor = Color3.fromHSV((t * 0.3 + 0.5) % 1, 0.9, 1)
				else
					hl.FillColor = cfg.c1
					hl.OutlineColor = cfg.c2
				end
				hl.FillTransparency = math.clamp(cfg.fill + (1 - cfg.fill) * 0.5 * (1 - pulse), 0, 1)
			end)
			return function()
				conn:Disconnect()
				hl:Destroy()
			end
		end,
	},

	-- КУЗНЕЧИК
	{
		name = "Кузнечик", kind = "toggle",
		params = {
			num("power", "Сила прыжка", 20, 200, 80, 5, 500),
			num("interval", "Пауза между прыжками", 0.1, 3, 0.6, 0.05, 10),
		},
		start = function(cfg)
			local root, hum = getRoot(), getHum()
			if not (root and hum) then return nil end
			local timer = 0
			local conn = RS.Heartbeat:Connect(function(dt)
				timer += dt
				if timer >= cfg.interval and hum.FloorMaterial ~= Enum.Material.Air and not State.Flying then
					timer = 0
					local v = root.AssemblyLinearVelocity
					root.AssemblyLinearVelocity = Vector3.new(v.X, cfg.power, v.Z)
				end
			end)
			return function() conn:Disconnect() end
		end,
	},

	-- РАКЕТА (одноразовый запуск)
	{
		name = "Ракета", kind = "action",
		params = {
			num("power", "Скорость подъёма", 50, 400, 150, 10, 1000),
			num("time", "Время полёта (сек)", 0.5, 6, 2, 0.1, 20),
			col("c1", "Цвет огня 1", C(255, 120, 0)),
			col("c2", "Цвет огня 2", C(255, 230, 150)),
		},
		start = function(cfg)
			local root = getRoot()
			if not root then return nil end
			local att = create("Attachment", { Position = Vector3.new(0, -2.5, 0) }, root)
			local fire = create("ParticleEmitter", {
				EmissionDirection = Enum.NormalId.Bottom,
				Rate = 250,
				Lifetime = NumberRange.new(0.4, 0.8),
				Speed = NumberRange.new(12, 22),
				SpreadAngle = Vector2.new(12, 12),
				LightEmission = 1,
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.2), NumberSequenceKeypoint.new(1, 0) }),
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
				Color = ColorSequence.new(cfg.c1, cfg.c2),
			}, att)
			local t0 = os.clock()
			local conn
			conn = RS.Heartbeat:Connect(function()
				if not root.Parent then conn:Disconnect() return end
				if os.clock() - t0 >= cfg.time then
					conn:Disconnect()
					fire.Enabled = false
					Debris:AddItem(att, 1.2)
					return
				end
				local v = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, cfg.power), v.Z)
			end)
			return nil
		end,
	},
}

-- конфиги и состояния скиллов
local Skills = {}
for _, def in ipairs(SkillDefs) do
	def.cfg, def.defaults = {}, {}
	for _, pr in ipairs(def.params) do
		def.cfg[pr.key] = pr.default
		def.defaults[pr.key] = pr.default
	end
	table.insert(Skills, def)
end

local function setSkill(skill, on)
	if on == (skill.stop ~= nil) then return end
	if on then
		local stop = skill.start(skill.cfg)
		if stop then
			skill.stop = stop
		elseif skill.setUI then
			skill.setUI(false)
		end
	else
		local s = skill.stop
		skill.stop = nil
		if s then s() end
	end
end

local function stopAllSkills()
	for _, s in ipairs(Skills) do
		if s.stop then
			local st = s.stop
			s.stop = nil
			st()
			if s.setUI then s.setUI(false) end
		end
	end
end

