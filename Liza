local rgbEnabled = false
local rgbConnection
local rgbObjects = {}

local function registerRGB(obj)
	rgbObjects[obj] = true
end

local function toggleRGB()
	rgbEnabled = not rgbEnabled

	if rgbConnection then
		rgbConnection:Disconnect()
		rgbConnection = nil
	end

	if rgbEnabled then
		rgbConnection = RunService.Heartbeat:Connect(function()
			local color = Color3.fromHSV((os.clock() * 0.25) % 1, 1, 1)

			for obj in pairs(rgbObjects) do
				if obj and obj.Parent then
					obj.Color = color

					local light = obj:FindFirstChildOfClass("PointLight")
					if light then light.Color = color end
				else
					rgbObjects[obj] = nil
				end
			end
		end)
	else
		for obj in pairs(rgbObjects) do
			if obj and obj.Parent then
				obj.Color = ACCENT

				local light = obj:FindFirstChildOfClass("PointLight")
				if light then light.Color = ACCENT end
			end
		end
	end
end

