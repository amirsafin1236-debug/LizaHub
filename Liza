	local exs = create("UIStroke", { Thickness = 1.5, Transparency = 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, exF)
	onTheme(exF, function() exs.Color = Theme.Accent end)
	local exList = create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
