		Position = UDim2.fromOffset(60, 32),
		Size = UDim2.new(1, -70, 0, 18),
		Text = "Нажми — сыграть в мини-игру",
		TextSize = 13,
		TextTransparency = 0.3,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, crow)
	bind(cs2, "TextColor3", "Text")
	bind(cs2, "Font", "Font")
	crow.Activated:Connect(openClaudeGame)
	note(pCred, "Вкладки Building и Кредиты добавлены с помощью Claude (Anthropic).")
end


