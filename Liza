		Position = UDim2.fromOffset(0, 84),
		Size = UDim2.new(1, 0, 1, -(84 + 112)),
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		ScrollingDirection = Enum.ScrollingDirection.XY,
	}, root)
	bind(sc, "BackgroundColor3", "Panel")
	corner(sc)

	local lineH = TextService:GetTextSize("A", EDIT_TS, Enum.Font.Code, Vector2.new(10000, 10000)).Y
	local errBar = create("Frame", {
		BackgroundColor3 = Color3.fromRGB(255, 70, 70),
		BackgroundTransparency = 0.75,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(2000, lineH),
		Visible = false,
	}, sc)

	local nums = create("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(4, 6),
		Size = UDim2.fromOffset(44, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Enum.Font.Code,
		TextSize = EDIT_TS,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextTransparency = 0.55,
		Text = "1",
	}, sc)
	bind(nums, "TextColor3", "Text")

	local box = create("TextBox", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(54, 6),
		Size = UDim2.fromOffset(400, 300),
		MultiLine = true,
		ClearTextOnFocus = false,
		TextWrapped = false,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Enum.Font.Code,
		TextSize = EDIT_TS,
		PlaceholderText = "-- пиши скрипт тут",
		Text = source or "",
	}, sc)
	bind(box, "TextColor3", "Text")

	local function layout()
		local vw, vh = sc.AbsoluteSize.X, sc.AbsoluteSize.Y
		local bw = math.max(vw - 70, box.TextBounds.X + 40)
		local bh = math.max(vh - 14, box.TextBounds.Y + 40)
		box.Size = UDim2.fromOffset(bw, bh)
		sc.CanvasSize = UDim2.fromOffset(bw + 60, bh + 14)
	end
	local function updateNums()
		local n = select(2, box.Text:gsub("\n", "")) + 1
		local t = {}
		for i = 1, n do t[i] = tostring(i) end
		nums.Text = table.concat(t, "\n")
	end
	box:GetPropertyChangedSignal("Text"):Connect(function()
		updateNums()
		layout()
		errBar.Visible = false
	end)
	box:GetPropertyChangedSignal("TextBounds"):Connect(layout)
	sc:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
	task.defer(function()
		updateNums()
		layout()
	end)

	-- запоминаем курсор (на телефоне при нажатии кнопок фокус пропадает)
	local lastCursor
	box:GetPropertyChangedSignal("CursorPosition"):Connect(function()
		if box.CursorPosition >= 1 then lastCursor = box.CursorPosition end
	end)
	local function insert(str, at)
		local txt = box.Text
		local pos = math.clamp(lastCursor or (#txt + 1), 1, #txt + 1)
		box.Text = txt:sub(1, pos - 1) .. str .. txt:sub(pos)
		local newPos = pos + (at or #str)
		lastCursor = newPos
		box:CaptureFocus()
		box.CursorPosition = newPos
	end

