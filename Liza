local function getTargetPosition()
    local camera = workspace.CurrentCamera
    if not camera then return nil end

    local mouse = UIS:GetMouseLocation()
    local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = getCharacter()
        and {getCharacter()} or {}

    local result = workspace:Raycast(
        ray.Origin, ray.Direction * 500, params
    )

    if result then return result.Position end
    return ray.Origin + ray.Direction * 40
end

local function makeObjectPart(name, position, anchored)
    local part = Instance.new("Part")
    part.Name = name
    part.Size =
        shape == "Sphere" and Vector3.new(2, 2, 2)
        or shape == "Circle" and Vector3.new(3, 0.45, 3)
        or Vector3.new(2.5, 2.5, 2.5)
    part.Shape =
        shape == "Sphere" and Enum.PartType.Ball
        or shape == "Circle" and Enum.PartType.Cylinder
        or Enum.PartType.Block
    part.Material = Enum.Material.SmoothPlastic
    part.Color = ACCENT
    part.Anchored = anchored
    part.CanCollide = true
    part.Position = position
    return part
end

