local scriptEditorOpen = false
local ScriptRuns = {}
local runScript

do
	local function makeGlobals(ctrl)
		local G = {}
		local spawned = setmetatable({}, { __mode = "k" })

		local function fmt(...)
			local p = {}
			for i = 1, select("#", ...) do p[i] = tostring((select(i, ...))) end
			return table.concat(p, " ")
		end
		local function vec3(a, b, c)
			if typeof(a) == "Vector3" then return a end
			if typeof(a) == "CFrame" then return a.Position end
			if type(a) == "number" then return Vector3.new(a, b or 0, c or 0) end
			error("нужен Vector3 или три числа", 0)
		end
		local function copyLib(lib)
			local t = {}
			for k, v in pairs(lib) do t[k] = v end
			return t
		end
		local function iterOf(t, ordered)
			if type(t) ~= "table" then error("нужна таблица", 0) end
			local items = {}
			if ordered then
				for k, v in ipairs(t) do items[#items + 1] = { k, v } end
			else
				for k, v in pairs(t) do items[#items + 1] = { k, v } end
			end
			return { __liza_iter = true, items = items }
		end

		-- вывод и время
		G.print = function(...) consoleAdd(fmt(...), "print") end
		G.warn = function(...) consoleAdd(fmt(...), "warn") end
		G.wait = function(t)
			ctrl.steps = 0
			task.wait(math.clamp(tonumber(t) or 0.03, 0.03, 60))
			if ctrl.stopFlag then error("__STOP__", 0) end
			return t
		end
		G.tick = os.clock
		G.notify = function(...) toast(fmt(...)) end

		-- базовые функции и библиотеки
		G.tostring, G.tonumber, G.type, G.typeof = tostring, tonumber, type, typeof
		G.pairs = function(t) return iterOf(t, false) end
		G.ipairs = function(t) return iterOf(t, true) end
		G.math = copyLib(math)
		G.string = { format = string.format, sub = string.sub, upper = string.upper, lower = string.lower, rep = string.rep, len = string.len }
		G.table = { insert = table.insert, remove = table.remove, concat = table.concat, sort = table.sort, unpack = table.unpack }
		G.Vector3 = { new = Vector3.new, zero = Vector3.zero, one = Vector3.one, xAxis = Vector3.xAxis, yAxis = Vector3.yAxis, zAxis = Vector3.zAxis }
		G.Color3 = { new = Color3.new, fromRGB = Color3.fromRGB, fromHSV = Color3.fromHSV, fromHex = Color3.fromHex }
		G.CFrame = { new = CFrame.new, Angles = CFrame.Angles, lookAt = CFrame.lookAt }
		G.Enum = Enum

		-- объекты игры
		G.player = player
		G.character = player.Character
		G.humanoid = getHum()
		G.root = getRoot()
		G.camera = workspace.CurrentCamera
		G.workspace = workspace
		G.mouse = setmetatable({}, {
			__index = function(_, k)
				if k == "Hit" then return mouse.Hit end
				if k == "Position" then return mouse.Hit and mouse.Hit.Position end
				if k == "Target" then return mouse.Target end
				return nil
			end,
		})

		-- команды
		G.speed = function(n)
			local h = getHum()
			if h then h.WalkSpeed = tonumber(n) or 16 end
		end
		G.jump = function(n)
			local h = getHum()
			if h then
				h.UseJumpPower = true
				h.JumpPower = tonumber(n) or 50
			end
		end
		G.dash = function(p)
			local r = getRoot()
			if r then r.AssemblyLinearVelocity = r.CFrame.LookVector * (tonumber(p) or 100) + Vector3.new(0, 20, 0) end
		end
		G.launch = function(a, b, c)
			local r = getRoot()
			if r then r.AssemblyLinearVelocity = vec3(a, b, c) end
		end
		G.teleport = function(a, b, c)
			local r = getRoot()
			if r then r.CFrame = CFrame.new(vec3(a, b, c)) end
		end

		local function newPart(pos, size, color, life)
			local p = Instance.new("Part")
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Size = typeof(size) == "Vector3" and size or Vector3.new(1, 1, 1)
			p.Color = typeof(color) == "Color3" and color or Color3.fromRGB(255, 140, 26)
			p.Material = Enum.Material.SmoothPlastic
			p.Position = vec3(pos)
			p.Parent = workspace
			spawned[p] = true
			Debris:AddItem(p, math.clamp(tonumber(life) or 5, 0.1, 60))
			return p
		end
		G.spawnPart = newPart
		G.shoot = function(speed, size, color, dmg)
			return fireBullet(speed, size, color, dmg or 20)
		end
		G.destroy = function(o)
			if typeof(o) == "Instance" and spawned[o] then o:Destroy() end
		end
		G.tween = function(o, props, t)
			if typeof(o) ~= "Instance" or type(props) ~= "table" then
				error("tween(объект, {Свойство = значение}, время)", 0)
			end
			TweenService:Create(o, TweenInfo.new(math.clamp(tonumber(t) or 1, 0.03, 60)), props):Play()
		end
		return G
	end

	runScript = function(src, fromEditor)
		local okp, ast = pcall(Lang.parse, src)
		if not okp then
			consoleAdd(tostring(ast), "error")
			if not scriptEditorOpen then toast("Ошибка: " .. tostring(ast), true) end
			return nil
		end
		if #ScriptRuns >= 8 then
			consoleAdd("слишком много запущенных скриптов (максимум 8)", "error")
			return nil
		end
		local ctrl = { steps = 0, stopFlag = false }
		local run = { ctrl = ctrl }
		table.insert(ScriptRuns, run)
		task.spawn(function()
			local G = makeGlobals(ctrl)
			local ok, err = pcall(Lang.execute, ast, G, ctrl)
			if not ok and tostring(err) ~= "__STOP__" then
				consoleAdd(tostring(err), "error")
				if not scriptEditorOpen then toast("Ошибка скрипта: " .. tostring(err), true) end
			end
			local i = table.find(ScriptRuns, run)
			if i then table.remove(ScriptRuns, i) end
			if fromEditor then consoleAdd("— скрипт завершён —", "info") end
		end)
		return run
	end
end

local function stopAllScripts()
	for _, r in ipairs(ScriptRuns) do r.ctrl.stopFlag = true end
	ScriptRuns = {}
end

