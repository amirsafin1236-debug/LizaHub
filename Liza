local Skills = {}
do
local function C(r, g, b) return Color3.fromRGB(r, g, b) end
local function col(key, label, default) return { key = key, label = label, type = "color", default = default } end
local function num(key, label, min, max, default, step, hardMax)
	return { key = key, label = label, type = "number", min = min, max = max, default = default, step = step, hardMax = hardMax }
end
local function bool(key, label, default) return { key = key, label = label, type = "bool", default = default } end

local SkillDefs = {
	-- ДИСКОТЕКА
	{
		name = "Дискотека", kind = "toggle",
		params = {
			col("c1", "Цвет дискотеки 1", C(255, 0, 120)),
			col("c2", "Цвет дискотеки 2", C(0, 200, 255)),
			col("c3", "Цвет дискотеки 3", C(255, 230, 0)),
			num("cspeed", "Скорость смены цвета", 0, 5, 0.8, 0.1, 30),
			num("spin", "Скорость вращения", 0, 1500, 300, 10, 10000),
			num("bright", "Яркость света", 0, 10, 3, 0.5, 50),
			num("range", "Радиус света", 5, 60, 25, 1, 200),
			bool("ball", "Дискошар над головой", true),
			bool("sparks", "Искры", true),
			bool("screen", "Цветной экран", true),
			num("tint", "Сила цвета экрана", 0, 1, 0.35, 0.05, 1),
		},
		start = function(cfg)
			local char, root, hum = player.Character, getRoot(), getHum()
			if not (char and root and hum) then return nil end

			local folder = create("Folder", { Name = "LizaDisco" }, workspace)
			local ball = create("Part", {
				Name = "Ball", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2),
				Material = Enum.Material.Neon, Anchored = true, CanCollide = false,
				CanQuery = false, CanTouch = false, CastShadow = false,
			}, folder)
			local light = create("PointLight", { Shadows = false }, ball)
			local sparks = create("ParticleEmitter", {
				Rate = 0,
				Lifetime = NumberRange.new(0.6, 1.1),
				Speed = NumberRange.new(8, 16),
				SpreadAngle = Vector2.new(180, 180),
				LightEmission = 1,
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
			}, ball)
			local cc = create("ColorCorrectionEffect", { Name = "LizaDiscoCC", TintColor = WHITE }, Lighting)

			local oldAuto = hum.AutoRotate
			local conn = RS.RenderStepped:Connect(function(dt)
				if not root.Parent then return end
				local t = os.clock()
				local k = (t * cfg.cspeed) % 3
				local i = math.floor(k)
				local cols = { cfg.c1, cfg.c2, cfg.c3 }
				local col1 = cols[i + 1]
				local col2 = cols[(i + 1) % 3 + 1]
				local c = col1:Lerp(col2, k - i)

				light.Color = c
				light.Brightness = cfg.bright
				light.Range = cfg.range
				ball.Color = c
				ball.Transparency = cfg.ball and 0 or 1
				ball.CFrame = root.CFrame * CFrame.new(0, 4.6, 0) * CFrame.Angles(0, t * 2, 0)
				sparks.Rate = cfg.sparks and 40 or 0
				sparks.Color = ColorSequence.new(c)
				cc.Enabled = cfg.screen
				cc.TintColor = WHITE:Lerp(c, cfg.tint)

				if cfg.spin ~= 0 then
					hum.AutoRotate = false
					root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(cfg.spin) * dt, 0)
				else
					hum.AutoRotate = oldAuto
				end
			end)
			return function()
				conn:Disconnect()
				folder:Destroy()
				cc:Destroy()
				if hum.Parent then hum.AutoRotate = oldAuto end
			end
		end,
	},

	-- РАДУЖНЫЙ СЛЕД
	{
		name = "Радужный след", kind = "toggle",
		params = {
			bool("rainbow", "Радуга", true),
			col("c1", "Цвет следа 1", C(255, 0, 120)),
			col("c2", "Цвет следа 2", C(0, 200, 255)),
			num("width", "Ширина", 0.2, 6, 1.5, 0.1, 20),
			num("life", "Длина следа (сек)", 0.2, 5, 1.2, 0.1, 20),
			num("glow", "Свечение", 0, 1, 1, 0.05, 1),
		},
		start = function(cfg)
			local root = getRoot()
			if not root then return nil end
			local a0 = create("Attachment", { Name = "LizaTrail0", Position = Vector3.new(0, 1.2, 0) }, root)
			local a1 = create("Attachment", { Name = "LizaTrail1", Position = Vector3.new(0, -1.2, 0) }, root)
			local tr = create("Trail", {
				Attachment0 = a0, Attachment1 = a1, FaceCamera = true,
				Transparency = NumberSequence.new(0, 1),
			}, root)
			local conn = RS.Heartbeat:Connect(function()
				tr.Lifetime = cfg.life
				tr.LightEmission = cfg.glow
				tr.WidthScale = NumberSequence.new(cfg.width)
				if cfg.rainbow then
					local t = os.clock() * 0.5
					local kps = {}
					for k = 0, 6 do
						table.insert(kps, ColorSequenceKeypoint.new(k / 6, Color3.fromHSV((k / 6 + t) % 1, 0.9, 1)))
					end
					tr.Color = ColorSequence.new(kps)
				else
					tr.Color = ColorSequence.new(cfg.c1, cfg.c2)
				end
			end)
			return function()
				conn:Disconnect()
				tr:Destroy() a0:Destroy() a1:Destroy()
			end
		end,
	},

	-- НЕОНОВАЯ АУРА
	{
		name = "Неоновая аура", kind = "toggle",
		params = {
			bool("rainbow", "Радуга", false),
			col("c1", "Цвет заливки", C(255, 140, 26)),
			col("c2", "Цвет контура", C(255, 255, 255)),
			num("fill", "Прозрачность заливки", 0, 1, 0.5, 0.05, 1),
			num("pulse", "Скорость пульсации", 0, 5, 1.5, 0.1, 30),
		},
		start = function(cfg)
			local char = player.Character
			if not char then return nil end
			local hl = create("Highlight", {
				Name = "LizaAura", Adornee = char, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
			}, char)
			local conn = RS.Heartbeat:Connect(function()
				local t = os.clock()
				local pulse = 0.5 + 0.5 * math.sin(t * cfg.pulse * math.pi * 2)
				if cfg.rainbow then
					hl.FillColor = Color3.fromHSV((t * 0.3) % 1, 0.9, 1)
					hl.OutlineColor = Color3.fromHSV((t * 0.3 + 0.5) % 1, 0.9, 1)
				else
					hl.FillColor = cfg.c1
					hl.OutlineColor = cfg.c2
				end
				hl.FillTransparency = math.clamp(cfg.fill + (1 - cfg.fill) * 0.5 * (1 - pulse), 0, 1)
			end)
			return function()
				conn:Disconnect()
				hl:Destroy()
			end
		end,
	},

	-- КУЗНЕЧИК
	{
		name = "Кузнечик", kind = "toggle",
		params = {
			num("power", "Сила прыжка", 20, 200, 80, 5, 500),
			num("interval", "Пауза между прыжками", 0.1, 3, 0.6, 0.05, 10),
		},
		start = function(cfg)
			local root, hum = getRoot(), getHum()
			if not (root and hum) then return nil end
			local timer = 0
			local conn = RS.Heartbeat:Connect(function(dt)
				timer += dt
				if timer >= cfg.interval and hum.FloorMaterial ~= Enum.Material.Air and not State.Flying then
					timer = 0
					local v = root.AssemblyLinearVelocity
					root.AssemblyLinearVelocity = Vector3.new(v.X, cfg.power, v.Z)
				end
			end)
			return function() conn:Disconnect() end
		end,
	},

	-- РАКЕТА (одноразовый запуск)
	{
		name = "Ракета", kind = "action",
		params = {
			num("power", "Скорость подъёма", 50, 400, 150, 10, 1000),
			num("time", "Время полёта (сек)", 0.5, 6, 2, 0.1, 20),
			col("c1", "Цвет огня 1", C(255, 120, 0)),
			col("c2", "Цвет огня 2", C(255, 230, 150)),
		},
		start = function(cfg)
			local root = getRoot()
			if not root then return nil end
			local att = create("Attachment", { Position = Vector3.new(0, -2.5, 0) }, root)
			local fire = create("ParticleEmitter", {
				EmissionDirection = Enum.NormalId.Bottom,
				Rate = 250,
				Lifetime = NumberRange.new(0.4, 0.8),
				Speed = NumberRange.new(12, 22),
				SpreadAngle = Vector2.new(12, 12),
				LightEmission = 1,
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.2), NumberSequenceKeypoint.new(1, 0) }),
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
				Color = ColorSequence.new(cfg.c1, cfg.c2),
			}, att)
			local t0 = os.clock()
			local conn
			conn = RS.Heartbeat:Connect(function()
				if not root.Parent then conn:Disconnect() return end
				if os.clock() - t0 >= cfg.time then
					conn:Disconnect()
					fire.Enabled = false
					Debris:AddItem(att, 1.2)
					return
				end
				local v = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(v.X, math.max(v.Y, cfg.power), v.Z)
			end)
			return nil
		end,
	},
}

-- конфиги и состояния скиллов
for _, def in ipairs(SkillDefs) do
	def.cfg, def.defaults = {}, {}
	for _, pr in ipairs(def.params) do
		def.cfg[pr.key] = pr.default
		def.defaults[pr.key] = pr.default
	end
	table.insert(Skills, def)
end
end

local function setSkill(skill, on)
	if on == (skill.stop ~= nil) then return end
	if on then
		local stop = skill.start(skill.cfg)
		if stop then
			skill.stop = stop
		elseif skill.setUI then
			skill.setUI(false)
		end
	else
		local s = skill.stop
		skill.stop = nil
		if s then s() end
	end
end

local function stopAllSkills()
	for _, s in ipairs(Skills) do
		if s.stop then
			local st = s.stop
			s.stop = nil
			st()
			if s.setUI then s.setUI(false) end
		end
	end
end

track(player.CharacterAdded:Connect(stopAllSkills))

