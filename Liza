-- пилюля-переключатель (для toggle и для строк Skills)
local function makePill(parent, default, callback)
	local pill = create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(40, 20),
		BorderSizePixel = 0,
	}, parent)
	create("UICorner", { CornerRadius = UDim.new(1, 0) }, pill)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, pill)
	create("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)

	local state = default
	local function render(animate)
		local pos = state and UDim2.new(1, -12, 0.5, 0) or UDim2.new(0, 12, 0.5, 0)
		local col = state and accentBg() or Theme.Bg
		if animate then
			twA("toggle", knob, { Position = pos })
			tw(pill, 0.2, { BackgroundColor3 = col })
		else
			knob.Position = pos
			pill.BackgroundColor3 = col
		end
	end
	onTheme(pill, function() render(false) end)
	table.insert(vipTargets, { inst = pill, want = function() return state end })

	return {
		set = function(v) state = v render(true) end,
		flip = function() state = not state render(true) callback(state) end,
		get = function() return state end,
	}
end

