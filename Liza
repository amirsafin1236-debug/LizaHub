		local g = tg.inst:FindFirstChild("LizaVip")
		if g then g:Destroy() end
		strokeText(tg.inst, false)
	end
	strokeText(titleLabel, false)
	strokeText(closeBtn, false)
end

local function sortedStops()
	local t = {}
	for _, s in ipairs(Vip.stops) do table.insert(t, s) end
	table.sort(t, function(a, b) return a.t < b.t end)
	return t
end

-- цвет кастома: "пинг-понг" по таймлайну 0..1, чтобы переливание было без шва.
-- Скорость 0 -> все цвета таймлайна ровно помещаются в кнопку.
local function sampleCustom(p, clock)
	local st = Vip.sorted or sortedStops()
	local u = (p + clock * Vip.speed) % 2
	if u > 1 then u = 2 - u end
	if u <= st[1].t then return st[1].c end
	local last = st[#st]
	if u >= last.t then return last.c end
	for i = 1, #st - 1 do
		local a, b = st[i], st[i + 1]
		if u >= a.t and u <= b.t then
			local span = b.t - a.t
			return a.c:Lerp(b.c, span > 1e-6 and (u - a.t) / span or 0)
		end
	end
	return last.c
end

local function vipSample(p, clock)
	if Vip.mode == "rainbow" then
		return Color3.fromHSV((p + clock * 0.25) % 1, 0.85, 1)
	elseif Vip.mode == "mono" then
		local w = 0.5 + 0.5 * math.sin((p + clock * 0.2) * math.pi * 2)
		local g = 0.04 + 0.92 * w
		return Color3.new(g, g, g)
	end
	return sampleCustom(p, clock)
end

local function buildSeq(fn)
	local kps = {}
	for k = 0, 15 do
		local p = k / 15
		table.insert(kps, ColorSequenceKeypoint.new(p, fn(p)))
	end
	return ColorSequence.new(kps)
end

local function vipSet(mode)
	if mode == "rainbow" or mode == "mono" then
		if not Vip.saved then Vip.saved = snapshot() end
		local b = BasePalettes[Vip.base]
		tweenTheme({ Accent = Theme.Accent, Bg = b.Bg, Panel = b.Panel, Text = b.Text })
	else
		if Vip.saved then
			tweenTheme(Vip.saved)
			Vip.saved = nil
		end
	end
	Vip.mode = mode
	if mode then
		strokeText(titleLabel, true)
		strokeText(closeBtn, true)
		currentThemeName = "VIP"
	else
		vipClear()
	end
	applyTheme()
end

local vipAcc = 0
track(RS.RenderStepped:Connect(function(dt)
	vipAcc += dt
	if vipAcc < 1 / 30 then return end
	vipAcc = 0
	local clock = os.clock()
	Vip.sorted = sortedStops()

	if Vip.mode then
		local seq = buildSeq(function(p) return vipSample(p, clock) end)
		for i = #vipTargets, 1, -1 do
			local tg = vipTargets[i]
			if tg.inst.Parent == nil then
				table.remove(vipTargets, i)
			else
				local g = tg.inst:FindFirstChild("LizaVip")
				if (not tg.want) or tg.want() then
					if not g then
						g = create("UIGradient", { Name = "LizaVip" }, tg.inst)
						strokeText(tg.inst, true)
					end
					g.Color = seq
				elseif g then
					g:Destroy()
					strokeText(tg.inst, false)
				end
			end
		end
	end

	if Vip.preview and Vip.preview.Parent then
		Vip.preview.Color = buildSeq(function(p) return sampleCustom(p, clock) end)
	end
end))

