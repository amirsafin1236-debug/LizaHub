local function getTargetPosition()
	local camera = workspace.CurrentCamera
	if not camera then return nil end

	local pos = UIS:GetMouseLocation()
	local ray = camera:ViewportPointToRay(pos.X, pos.Y)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude

	local character = getCharacter()
	params.FilterDescendantsInstances = character and {character} or {}

	local hit = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
	return hit and hit.Position or (ray.Origin + ray.Direction * 40)
end

local function createCustomObject(position)
	local part = Instance.new("Part")
	part.Name = "LizaHubCustomObject"

	part.Size = objectShape == "Sphere" and Vector3.new(2, 2, 2)
		or (objectShape == "Circle" and Vector3.new(4, 0.35, 4) or Vector3.new(3, 3, 3))

	part.Shape = objectShape == "Sphere" and Enum.PartType.Ball
		or (objectShape == "Circle" and Enum.PartType.Cylinder or Enum.PartType.Block)

	part.Material = Enum.Material.Neon
	part.Color = ACCENT
	part.Anchored = true
	part.CanCollide = true
	part.Position = position
	part.Parent = workspace

	table.insert(customObjects, part)
	return part
end

button(itemsPage, "Create / Use Object", function()
	local root = getRoot()
	if not root then return end

	local target = getTargetPosition()

	if objectMode == "Teleport" then
		if target then
			root.CFrame = CFrame.new(target + Vector3.new(0, 3, 0))
		end
	elseif objectMode == "Throw" then
		local part = createCustomObject(
			root.Position + root.CFrame.LookVector * 4 + Vector3.new(0, 2, 0)
		)

		part.Anchored = false

		local offset = target and (target - part.Position) or root.CFrame.LookVector
		local direction = offset.Magnitude > 0 and offset.Unit or root.CFrame.LookVector

		part.AssemblyLinearVelocity = direction * 85 + Vector3.new(0, 18, 0)
	else
		createCustomObject(
			(target or (root.Position + root.CFrame.LookVector * 6))
				+ Vector3.new(0, 1.5, 0)
		)
	end
end)

