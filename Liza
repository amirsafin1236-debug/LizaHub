local function fx(b)
	b.MouseEnter:Connect(function() tw(b, 0.12, { BackgroundTransparency = 0.12 }) end)
	b.MouseLeave:Connect(function() tw(b, 0.15, { BackgroundTransparency = 0 }) end)
	b.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			tw(b, 0.08, { BackgroundTransparency = 0.35 })
		end
	end)
	b.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			tw(b, 0.18, { BackgroundTransparency = 0 })
		end
	end)
end

