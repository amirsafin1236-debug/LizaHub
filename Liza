	}, row)
	bind(lbl, "TextColor3", "Text")
	bind(lbl, "Font", "Font")

	local box = create("TextBox", {
		Position = UDim2.new(1, -74, 0, 4),
		Size = UDim2.fromOffset(64, 22),
		Text = tostring(default),
		TextSize = 14,
		ClearTextOnFocus = false,
		BorderSizePixel = 0,
	}, row)
	bind(box, "BackgroundColor3", "Bg")
	bind(box, "TextColor3", "Text")
	bind(box, "Font", "Font")
	corner(box)

	local bar = create("Frame", {
		Position = UDim2.new(0, 10, 0, 38),
		Size = UDim2.new(1, -20, 0, 8),
		BorderSizePixel = 0,
	}, row)
	bind(bar, "BackgroundColor3", "Bg")
	corner(bar)
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 }, bar)
	bind(fill, "BackgroundColor3", "Accent")
	corner(fill)

	local hit = create("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		Position = UDim2.new(0, 0, 0, 28),
		Size = UDim2.new(1, 0, 0, 28),
	}, row)

	local function set(v, fire)
		v = math.clamp(v, min, hardMax or max)
		box.Text = tostring(math.floor(v * 100 + 0.5) / 100)
		fill.Size = UDim2.fromScale(math.clamp((v - min) / (max - min), 0, 1), 1)
		if fire ~= false then callback(v) end
	end
	set(default, false)

	dragArea(hit, bar, function(rx)
		local v = min + (max - min) * rx
		set(math.floor(v / step + 0.5) * step)
	end)
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then set(n) else set(default, false) end
	end)
	return function(v) set(v, false) end
end

