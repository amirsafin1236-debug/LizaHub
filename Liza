local function toHex(col)
    return string.format(
        "#%02X%02X%02X",
        math.floor(col.R * 255 + 0.5),
        math.floor(col.G * 255 + 0.5),
        math.floor(col.B * 255 + 0.5)
    )
end

local h, s, v = Color3.toHSV(accent)

local function updateColor()
    h = h % 1
    s = math.clamp(s, 0, 1)
    v = math.clamp(v, 0, 1)

    local col = Color3.fromHSV(h, s, v)
    square.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
    cursor.Position = UDim2.fromScale(s, 1 - v)
    hueMarker.Position = UDim2.new(h, 0, 0.5, 0)
    preview.BackgroundColor3 = col
    hexLabel.Text = toHex(col)
end

local function setHue(input)
    local width = hueBar.AbsoluteSize.X
    if width <= 0 then return end
    h = math.clamp(
        (input.Position.X - hueBar.AbsolutePosition.X) / width,
        0, 1
    )
    updateColor()
end

local function setSquare(input)
    local size = square.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return end
    s = math.clamp(
        (input.Position.X - square.AbsolutePosition.X) / size.X,
        0, 1
    )
    v = 1 - math.clamp(
        (input.Position.Y - square.AbsolutePosition.Y) / size.Y,
        0, 1
    )
    updateColor()
end

local draggingHue = false
local draggingSquare = false
local activeTouch = nil

local function beginHue(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingHue = true
        setHue(input)
    elseif input.UserInputType == Enum.UserInputType.Touch then
        draggingHue = true
        activeTouch = input
        setHue(input)
    end
end

local function beginSquare(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSquare = true
        setSquare(input)
    elseif input.UserInputType == Enum.UserInputType.Touch then
        draggingSquare = true
        activeTouch = input
        setSquare(input)
    end
end

hueBar.InputBegan:Connect(beginHue)
square.InputBegan:Connect(beginSquare)

UIS.InputChanged:Connect(function(input)
    if draggingHue and input.UserInputType == Enum.UserInputType.MouseMovement then
        setHue(input)
    elseif draggingSquare and input.UserInputType == Enum.UserInputType.MouseMovement then
        setSquare(input)
    elseif input == activeTouch then
        if draggingHue then setHue(input) end
        if draggingSquare then setSquare(input) end
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        draggingHue = false
        draggingSquare = false
        if input == activeTouch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            activeTouch = nil
        end
    end
end)

