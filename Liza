		local part = makeObjectPart("LizaHubThrownObject", spawnPosition, false)
		part.Parent = workspace

		local offset = target and (target - part.Position) or root.CFrame.LookVector
		local direction = offset.Magnitude > 0 and offset.Unit or root.CFrame.LookVector
		part.AssemblyLinearVelocity = direction * 90 + Vector3.new(0, 15, 0)
		part.AssemblyAngularVelocity = Vector3.new(math.random(-12, 12), math.random(-12, 12), math.random(-12, 12))

