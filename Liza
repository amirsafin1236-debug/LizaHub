local openSkillEditor
openSkillEditor = function(skill)
	local p = showPopup(330, 288, skill.name)
	local sc = popupList(p)

	input(sc, "Название кнопки", skill.name, function(t)
		if t ~= "" then
			skill.name = t
			if skill.nameLabel then skill.nameLabel.Text = t end
		end
	end)

	for _, pr in ipairs(skill.params) do
		if pr.type == "color" then
			colorRow(sc, pr.label, skill.cfg[pr.key], function()
				pickColor(pr.label, skill.cfg[pr.key], function(c) skill.cfg[pr.key] = c end, function()
					openSkillEditor(skill)
				end)
			end)
		elseif pr.type == "number" then
			slider(sc, pr.label, pr.min, pr.max, skill.cfg[pr.key], pr.step, pr.hardMax, function(v)
				skill.cfg[pr.key] = v
			end)
		else
			toggle(sc, pr.label, skill.cfg[pr.key], function(v) skill.cfg[pr.key] = v end)
		end
	end

	button(sc, "Сбросить настройки", function()
		for k, v in pairs(skill.defaults) do skill.cfg[k] = v end
		openSkillEditor(skill)
	end, true)
end

