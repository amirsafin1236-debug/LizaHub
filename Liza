	}, holder)
	create("UICorner", { CornerRadius = UDim.new(0, 8) }, sv)

	local white = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, sv)
	create("UICorner", { CornerRadius = UDim.new(0, 8) }, white)
	create("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)

	local black = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BorderSizePixel = 0 }, sv)
	create("UICorner", { CornerRadius = UDim.new(0, 8) }, black)
	create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, black)

	local svCur = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, sv)
	create("UICorner", { CornerRadius = UDim.new(1, 0) }, svCur)
	create("UIStroke", { Color = BLACK, Thickness = 3 }, svCur)
	local inner = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, svCur)
	create("UICorner", { CornerRadius = UDim.new(1, 0) }, inner)
	create("UIStroke", { Color = WHITE, Thickness = 2 }, inner)

	local hue = create("Frame", {
		Position = UDim2.fromOffset(size + 10, 0),
		Size = UDim2.fromOffset(20, size),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, holder)
	create("UICorner", { CornerRadius = UDim.new(0, 6) }, hue)
	local kps = {}
	for k = 0, 6 do
		table.insert(kps, ColorSequenceKeypoint.new(k / 6, Color3.fromHSV((k % 6) / 6, 1, 1)))
	end
	create("UIGradient", { Rotation = 90, Color = ColorSequence.new(kps) }, hue)
	local hueCur = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(1, 6, 0, 6),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, hue)
	create("UICorner", { CornerRadius = UDim.new(0, 3) }, hueCur)
	create("UIStroke", { Color = BLACK, Thickness = 1.5 }, hueCur)

	local svHit = create("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 3 }, sv)
	local hueHit = create("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		Position = UDim2.fromOffset(-5, 0),
		Size = UDim2.new(1, 10, 1, 0),
		ZIndex = 3,
	}, hue)

	local function refresh(fire)
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCur.Position = UDim2.fromScale(s, 1 - v)
		hueCur.Position = UDim2.fromScale(0.5, h)
		if fire then onChange(Color3.fromHSV(h, s, v)) end
	end

	dragArea(svHit, sv, function(rx, ry)
		s, v = rx, 1 - ry
		refresh(true)
	end)
	dragArea(hueHit, hue, function(_, ry)
		h = math.min(ry, 0.9999)
		refresh(true)
	end)

	refresh(false)
	return {
		set = function(c)
			h, s, v = c:ToHSV()
			refresh(false)
		end,
	}
end

