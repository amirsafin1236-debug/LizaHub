	local con = create("Frame", {
		Position = UDim2.new(0, 0, 1, -104),
		Size = UDim2.new(1, 0, 0, 104),
		BorderSizePixel = 0,
	}, root)
	bind(con, "BackgroundColor3", "Panel")
	corner(con)
	local ch = create("TextLabel", {
