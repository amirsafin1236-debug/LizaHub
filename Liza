-- ПУЛЯ: летит, РЕАЛЬНО попадает и наносит ЛОКАЛЬНЫЙ урон (виден только тебе)
local function fireBullet(speed, size, color, damage)
	local root = getRoot()
	if not root then return nil end
	speed = math.clamp(tonumber(speed) or 150, 10, 1000)
	size = math.clamp(tonumber(size) or 1.5, 0.3, 20)
	damage = math.max(tonumber(damage) or 0, 0)
	if typeof(color) ~= "Color3" then color = Theme.Accent end

	local dir = workspace.CurrentCamera.CFrame.LookVector
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(size, size, size)
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Position = root.Position + Vector3.new(0, 1, 0) + dir * 3
	p.Parent = workspace

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, p }

	local function burst(pos)
		local fxp = create("Part", {
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size, size),
			Material = Enum.Material.Neon,
			Color = color,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Position = pos,
		}, workspace)
		tw(fxp, 0.25, { Size = Vector3.new(size * 4, size * 4, size * 4), Transparency = 1 })
		Debris:AddItem(fxp, 0.3)
	end

	local function findHumanoid(inst)
		local m = inst
		while m and m ~= workspace do
			local h = m:FindFirstChildOfClass("Humanoid")
			if h then return h, m end
			m = m.Parent
		end
		return nil, nil
	end

	local function hurt(hum, model, hitPart)
		hum.Health = math.max(0, hum.Health - damage)
		-- красная вспышка по модели
		local hl = create("Highlight", {
			FillColor = Color3.fromRGB(255, 60, 60),
			FillTransparency = 0.35,
			OutlineTransparency = 1,
			Adornee = model,
		}, model)
		tw(hl, 0.35, { FillTransparency = 1 })
		Debris:AddItem(hl, 0.4)
		-- всплывающее число урона
		local head = model:FindFirstChild("Head") or hitPart
		local bb = create("BillboardGui", {
			Size = UDim2.fromOffset(120, 40),
			StudsOffset = Vector3.new(0, 3, 0),
			AlwaysOnTop = true,
			Adornee = head,
		}, head)
		local lb = create("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "-" .. tostring(math.floor(damage + 0.5)),
			TextScaled = true,
			Font = Enum.Font.GothamBold,
			TextColor3 = Color3.fromRGB(255, 80, 80),
			TextStrokeTransparency = 0,
		}, bb)
		tw(bb, 0.7, { StudsOffset = Vector3.new(0, 5.5, 0) })
		tw(lb, 0.7, { TextTransparency = 1, TextStrokeTransparency = 1 })
		Debris:AddItem(bb, 0.8)
	end

	local life = 0
	local conn
	conn = RS.Heartbeat:Connect(function(dt)
		life += dt
		if not p.Parent or life > 3 then
			conn:Disconnect()
			if p.Parent then p:Destroy() end
			return
		end
		local step = dir * speed * dt
		local res
		local ok, r = pcall(function() return workspace:Spherecast(p.Position, size / 2, step, params) end)
		if ok then res = r else res = workspace:Raycast(p.Position, step, params) end
		if res then
			conn:Disconnect()
			burst(res.Position)
			p:Destroy()
			local hum, model = findHumanoid(res.Instance)
			if hum and hum.Health > 0 and damage > 0 then hurt(hum, model, res.Instance) end
		else
			p.Position = p.Position + step
		end
	end)
	return p
end

local Lang = {}
do
	local KEYWORDS = {}
	for _, k in ipairs({ "and", "break", "do", "else", "elseif", "end", "false", "for", "function", "if", "in", "local", "nil", "not", "or", "return", "then", "true", "while" }) do
		KEYWORDS[k] = true
	end

	local function lerr(line, msg)
		error("строка " .. tostring(line) .. ": " .. msg, 0)
	end

	---------------- ЛЕКСЕР ----------------
	function Lang.tokenize(src)
		local toks, i, line, n = {}, 1, 1, #src
		local function push(t, v) toks[#toks + 1] = { t = t, v = v, line = line } end
		local ESC = { n = "\n", t = "\t", r = "\r", ["\\"] = "\\", ['"'] = '"', ["'"] = "'" }
		while i <= n do
			local c = src:sub(i, i)
			if c == "\n" then
				line += 1
				i += 1
			elseif c:match("%s") then
				i += 1
			elseif c == "-" and src:sub(i + 1, i + 1) == "-" then
				if src:sub(i, i + 3) == "--[[" then
					local e = src:find("]]", i + 4, true)
					local chunk = src:sub(i, e and e + 1 or n)
					for _ in chunk:gmatch("\n") do line += 1 end
					i = e and e + 2 or n + 1
				else
					local e = src:find("\n", i, true)
					i = e or n + 1
				end
			elseif c:match("[%a_]") then
				local s = src:match("^[%w_]+", i)
				i += #s
				push(KEYWORDS[s] and "kw" or "name", s)
			elseif c:match("%d") or (c == "." and src:sub(i + 1, i + 1):match("%d")) then
				local s = src:match("^%d+%.?%d*[eE][%+%-]?%d+", i)
					or src:match("^%.%d+[eE][%+%-]?%d+", i)
					or src:match("^%d+%.?%d*", i)
					or src:match("^%.%d+", i)
				i += #s
				push("num", s)
			elseif c == '"' or c == "'" then
				local j, buf = i + 1, {}
				while true do
					local ch = src:sub(j, j)
					if ch == "" or ch == "\n" then lerr(line, "незакрытая строка") end
					if ch == c then break end
					if ch == "\\" then
						local nx = src:sub(j + 1, j + 1)
						buf[#buf + 1] = ESC[nx] or nx
						j += 2
					else
						buf[#buf + 1] = ch
						j += 1
					end
				end
				push("str", table.concat(buf))
				i = j + 1
			else
				local three, two = src:sub(i, i + 2), src:sub(i, i + 1)
				if three == "..." then
					push("op", "...")
					i += 3
				elseif two == "==" or two == "~=" or two == "<=" or two == ">=" or two == ".." then
					push("op", two)
					i += 2
				elseif ("+-*/%^#<>=(){}[];:,."):find(c, 1, true) then
					push("op", c)
					i += 1
				else
					lerr(line, "неизвестный символ '" .. c .. "'")
				end
			end
		end
		toks[#toks + 1] = { t = "eof", v = "<конец>", line = line }
		return toks
	end

	---------------- ПАРСЕР ----------------
	local BIN = {
		["or"] = { 1, 1 }, ["and"] = { 2, 2 },
		["<"] = { 3, 3 }, [">"] = { 3, 3 }, ["<="] = { 3, 3 }, [">="] = { 3, 3 }, ["~="] = { 3, 3 }, ["=="] = { 3, 3 },
		[".."] = { 9, 8 }, ["+"] = { 10, 10 }, ["-"] = { 10, 10 },
		["*"] = { 11, 11 }, ["/"] = { 11, 11 }, ["%"] = { 11, 11 }, ["^"] = { 14, 13 },
	}

	function Lang.parse(src)
		local toks = Lang.tokenize(src)
		local pos = 1
		local parseExpr, parseBlock, parseStatement, parseSuffixed, parseFuncBody, parseSimple, parseTable

		local function check(t, v)
			local k = toks[pos]
			return k.t == t and (v == nil or k.v == v)
		end
		local function nextTok()
			local k = toks[pos]
			if k.t ~= "eof" then pos += 1 end
			return k
		end
		local function accept(t, v)
			if check(t, v) then return nextTok() end
			return nil
		end
		local function expect(t, v)
			if check(t, v) then return nextTok() end
			local k = toks[pos]
			lerr(k.line, "ожидалось '" .. tostring(v or t) .. "', а найдено '" .. tostring(k.v) .. "'")
		end
		local function blockEnd()
			local k = toks[pos]
			return k.t == "eof" or (k.t == "kw" and (k.v == "end" or k.v == "else" or k.v == "elseif"))
		end
		local function binOp()
			local k = toks[pos]
			if (k.t == "op" or (k.t == "kw" and (k.v == "and" or k.v == "or"))) and BIN[k.v] then return k.v end
			return nil
		end
		local function parseArgs()
			expect("op", "(")
			local args = {}
			if not check("op", ")") then
				args[1] = parseExpr()
				while accept("op", ",") do args[#args + 1] = parseExpr() end
			end
			expect("op", ")")
			return args
		end

		parseBlock = function()
			local stmts = {}
			while not blockEnd() do
				stmts[#stmts + 1] = parseStatement()
				accept("op", ";")
			end
			return stmts
		end

		parseFuncBody = function(line, isMethod)
			expect("op", "(")
			local params = {}
			if isMethod then params[1] = "self" end
			if not check("op", ")") then
				params[#params + 1] = expect("name").v
				while accept("op", ",") do params[#params + 1] = expect("name").v end
			end
			expect("op", ")")
			local body = parseBlock()
			expect("kw", "end")
			return { t = "Func", params = params, body = body, line = line }
		end

		parseTable = function()
			local line = nextTok().line
			local items = {}
			while not check("op", "}") do
				if check("op", "[") then
					nextTok()
					local kx = parseExpr()
					expect("op", "]")
					expect("op", "=")
					items[#items + 1] = { k = kx, v = parseExpr() }
				elseif check("name") and toks[pos + 1].t == "op" and toks[pos + 1].v == "=" then
					local nm = nextTok().v
					nextTok()
					items[#items + 1] = { k = { t = "Str", v = nm }, v = parseExpr() }
				else
					items[#items + 1] = { v = parseExpr() }
				end
				if not (accept("op", ",") or accept("op", ";")) then break end
			end
			expect("op", "}")
			return { t = "Table", items = items, line = line }
		end

		parseSuffixed = function()
			local k = toks[pos]
			local e
			if k.t == "name" then
				nextTok()
				e = { t = "Var", name = k.v, line = k.line }
			elseif k.t == "op" and k.v == "(" then
				nextTok()
				e = { t = "Paren", e = parseExpr(), line = k.line }
				expect("op", ")")
			else
				lerr(k.line, "неожиданный '" .. tostring(k.v) .. "'")
			end
			while true do
				local t = toks[pos]
				if t.t == "op" and t.v == "." then
					nextTok()
					local nm = expect("name").v
					e = { t = "Index", obj = e, key = { t = "Str", v = nm }, line = t.line }
				elseif t.t == "op" and t.v == "[" then
					nextTok()
					local kx = parseExpr()
					expect("op", "]")
					e = { t = "Index", obj = e, key = kx, line = t.line }
				elseif t.t == "op" and t.v == ":" then
					nextTok()
					local nm = expect("name").v
					e = { t = "MethCall", obj = e, name = nm, args = parseArgs(), line = t.line }
				elseif t.t == "op" and t.v == "(" then
					e = { t = "Call", f = e, args = parseArgs(), line = t.line }
				else
					break
				end
			end
			return e
		end

		parseSimple = function()
			local k = toks[pos]
			if k.t == "num" then
				nextTok()
				return { t = "Num", v = tonumber(k.v) or 0, line = k.line }
			elseif k.t == "str" then
				nextTok()
				return { t = "Str", v = k.v, line = k.line }
			elseif k.t == "kw" then
				if k.v == "nil" then nextTok() return { t = "Nil", line = k.line }
				elseif k.v == "true" then nextTok() return { t = "Bool", v = true, line = k.line }
				elseif k.v == "false" then nextTok() return { t = "Bool", v = false, line = k.line }
				elseif k.v == "function" then nextTok() return parseFuncBody(k.line, false) end
			elseif k.t == "op" and k.v == "{" then
				return parseTable()
			end
			return parseSuffixed()
		end

		local function parseSub(limit)
			local k = toks[pos]
			local left
			if (k.t == "kw" and k.v == "not") or (k.t == "op" and (k.v == "-" or k.v == "#")) then
				nextTok()
				left = { t = "Un", op = k.v, e = parseSub(12), line = k.line }
			else
				left = parseSimple()
			end
			while true do
				local op = binOp()
				if not op or BIN[op][1] <= limit then break end
				local ln = toks[pos].line
				nextTok()
				local right = parseSub(BIN[op][2])
				left = { t = "Bin", op = op, a = left, b = right, line = ln }
			end
			return left
		end
		parseExpr = function() return parseSub(0) end

		parseStatement = function()
			local k = toks[pos]
			local line = k.line
			if k.t == "kw" then
				if k.v == "local" then
					nextTok()
					if accept("kw", "function") then
						local name = expect("name").v
						return { t = "LocalFunc", name = name, f = parseFuncBody(line, false), line = line }
					end
					local names = { expect("name").v }
					while accept("op", ",") do names[#names + 1] = expect("name").v end
					local exprs = {}
					if accept("op", "=") then
						exprs[1] = parseExpr()
						while accept("op", ",") do exprs[#exprs + 1] = parseExpr() end
					end
					return { t = "Local", names = names, exprs = exprs, line = line }
				elseif k.v == "function" then
					nextTok()
					local target = { t = "Var", name = expect("name").v, line = line }
					local isMethod = false
					while check("op", ".") or check("op", ":") do
						local sep = nextTok().v
						local nm = expect("name").v
						target = { t = "Index", obj = target, key = { t = "Str", v = nm }, line = line }
						if sep == ":" then isMethod = true break end
					end
					local f = parseFuncBody(line, isMethod)
					return { t = "Assign", targets = { target }, exprs = { f }, line = line }
				elseif k.v == "if" then
					nextTok()
					local cond = parseExpr()
					expect("kw", "then")
					local clauses = { { cond = cond, body = parseBlock() } }
					local elseBody
					while true do
						if accept("kw", "elseif") then
							local c2 = parseExpr()
							expect("kw", "then")
							clauses[#clauses + 1] = { cond = c2, body = parseBlock() }
						elseif accept("kw", "else") then
							elseBody = parseBlock()
							expect("kw", "end")
							break
						else
							expect("kw", "end")
							break
						end
					end
					return { t = "If", clauses = clauses, elseBody = elseBody, line = line }
				elseif k.v == "while" then
					nextTok()
					local cond = parseExpr()
					expect("kw", "do")
					local body = parseBlock()
					expect("kw", "end")
					return { t = "While", cond = cond, body = body, line = line }
				elseif k.v == "for" then
					nextTok()
					local n1 = expect("name").v
					if accept("op", "=") then
						local a = parseExpr()
						expect("op", ",")
						local b = parseExpr()
						local c
						if accept("op", ",") then c = parseExpr() end
						expect("kw", "do")
						local body = parseBlock()
						expect("kw", "end")
						return { t = "NumFor", var = n1, a = a, b = b, c = c, body = body, line = line }
					else
						local names = { n1 }
						while accept("op", ",") do names[#names + 1] = expect("name").v end
						expect("kw", "in")
						local e = parseExpr()
						expect("kw", "do")
						local body = parseBlock()
						expect("kw", "end")
						return { t = "GenFor", names = names, e = e, body = body, line = line }
					end
				elseif k.v == "return" then
					nextTok()
					local e
					if not blockEnd() and not check("op", ";") then e = parseExpr() end
					return { t = "Return", e = e, line = line }
				elseif k.v == "break" then
					nextTok()
					return { t = "Break", line = line }
				elseif k.v == "do" then
					nextTok()
					local body = parseBlock()
					expect("kw", "end")
					return { t = "Do", body = body, line = line }
				end
			end
			-- вызов функции или присваивание
			local e = parseSuffixed()
			if check("op", "=") or check("op", ",") then
				local targets = { e }
				while accept("op", ",") do targets[#targets + 1] = parseSuffixed() end
				expect("op", "=")
				local exprs = { parseExpr() }
				while accept("op", ",") do exprs[#exprs + 1] = parseExpr() end
				for _, t in ipairs(targets) do
					if t.t ~= "Var" and t.t ~= "Index" then lerr(line, "сюда нельзя присвоить значение") end
				end
				return { t = "Assign", targets = targets, exprs = exprs, line = line }
			end
			if e.t ~= "Call" and e.t ~= "MethCall" then
				lerr(line, "ожидалась команда (вызов функции или присваивание)")
			end
			return { t = "ExprStat", e = e, line = line }
		end

		local body = parseBlock()
		if toks[pos].t ~= "eof" then
			lerr(toks[pos].line, "лишнее '" .. tostring(toks[pos].v) .. "'")
		end
		return body
	end

	---------------- ИНТЕРПРЕТАТОР ----------------
	local ALLOWED_METHODS = {}
	for _, m in ipairs({
		"FindFirstChild", "FindFirstChildOfClass", "FindFirstChildWhichIsA", "GetChildren", "GetDescendants",
		"IsA", "Clone", "ChangeState", "MoveTo", "GetPivot", "PivotTo", "GetAttribute", "SetAttribute",
		"GetMass", "ApplyImpulse", "ApplyAngularImpulse",
	}) do
		ALLOWED_METHODS[m] = true
	end

	local BINFN = {
		["+"] = function(a, b) return a + b end,
		["-"] = function(a, b) return a - b end,
		["*"] = function(a, b) return a * b end,
		["/"] = function(a, b) return a / b end,
		["%"] = function(a, b) return a % b end,
		["^"] = function(a, b) return a ^ b end,
		[".."] = function(a, b) return a .. b end,
		["=="] = function(a, b) return a == b end,
		["~="] = function(a, b) return a ~= b end,
		["<"] = function(a, b) return a < b end,
		["<="] = function(a, b) return a <= b end,
		[">"] = function(a, b) return a > b end,
		[">="] = function(a, b) return a >= b end,
	}

	function Lang.execute(ast, G, ctrl)
		local scriptFn = setmetatable({}, { __mode = "k" })
		local eval, exec, execBlock

		local function rt(node, msg)
			error("строка " .. tostring(node and node.line or "?") .. ": " .. msg, 0)
		end
		local function truthy(v) return v ~= nil and v ~= false end
		local function newScope(p) return { v = {}, d = {}, p = p } end
		local function findScope(s, name)
			while s do
				if s.d[name] then return s end
				s = s.p
			end
			return nil
		end
		local function getVar(s, name)
			local f = findScope(s, name)
			if f then return f.v[name] end
			return G[name]
		end
		local function setVar(s, name, val)
			local f = findScope(s, name)
			if f then f.v[name] = val else G[name] = val end
		end
		local function declare(s, name, val)
			s.d[name] = true
			s.v[name] = val
		end
		local function tick(node)
			ctrl.steps += 1
			if ctrl.stopFlag then error("__STOP__", 0) end
			if ctrl.steps > 60000 then
				ctrl.steps = 0
				rt(node, "слишком долго без wait() — добавь wait() в цикл")
			end
		end

		local function indexValue(obj, key, node)
			if obj == nil then rt(node, "обращение к nil (поле '" .. tostring(key) .. "')") end
			local ty = typeof(obj)
			if ty == "table" then return obj[key] end
			local ok, v = pcall(function() return obj[key] end)
			if not ok then rt(node, "нет поля '" .. tostring(key) .. "'") end
			if v == game then return nil end
			return v
		end

		local function setIndex(obj, key, val, node)
			if obj == nil then rt(node, "присваивание в nil") end
			local ty = typeof(obj)
			if ty == "table" then
				obj[key] = val
			elseif ty == "Instance" then
				local ok = pcall(function() obj[key] = val end)
				if not ok then rt(node, "не получилось изменить '" .. tostring(key) .. "'") end
			else
				rt(node, "это значение нельзя изменять")
			end
		end

		local function callFn(f, args, n, node)
			if type(f) ~= "function" then rt(node, "это не функция") end
			if scriptFn[f] then return f(table.unpack(args, 1, n)) end
			local res = table.pack(pcall(f, table.unpack(args, 1, n)))
			if not res[1] then
				local m = tostring(res[2])
				if m == "__STOP__" then error(m, 0) end
				rt(node, m)
			end
			return res[2]
		end

		local function makeFunc(node, scope)
			local f = function(...)
				local fs = newScope(scope)
				local args = { ... }
				for i, name in ipairs(node.params) do declare(fs, name, args[i]) end
				local sig, val = execBlock(node.body, fs)
				if sig == "return" then return val end
				return nil
			end
			scriptFn[f] = true
			return f
		end

		eval = function(n, scope)
			local t = n.t
			if t == "Num" or t == "Str" or t == "Bool" then
				return n.v
			elseif t == "Nil" then
				return nil
			elseif t == "Var" then
				return getVar(scope, n.name)
			elseif t == "Paren" then
				return eval(n.e, scope)
			elseif t == "Func" then
				return makeFunc(n, scope)
			elseif t == "Table" then
				local tbl, idx = {}, 1
				for _, it in ipairs(n.items) do
					if it.k then
						tbl[eval(it.k, scope)] = eval(it.v, scope)
					else
						tbl[idx] = eval(it.v, scope)
						idx += 1
					end
				end
				return tbl
			elseif t == "Index" then
				return indexValue(eval(n.obj, scope), eval(n.key, scope), n)
			elseif t == "Call" then
				local f = eval(n.f, scope)
				local args = {}
				for i = 1, #n.args do args[i] = eval(n.args[i], scope) end
				return callFn(f, args, #n.args, n)
			elseif t == "MethCall" then
				local obj = eval(n.obj, scope)
				if obj == nil then rt(n, "вызов метода '" .. n.name .. "' у nil") end
				local args = {}
				for i = 1, #n.args do args[i] = eval(n.args[i], scope) end
				if typeof(obj) == "Instance" then
					if not ALLOWED_METHODS[n.name] then rt(n, "метод '" .. n.name .. "' не разрешён") end
					local ok, res = pcall(function()
						return obj[n.name](obj, table.unpack(args, 1, #n.args))
					end)
					if not ok then rt(n, tostring(res)) end
					if res == game then return nil end
					return res
				end
				local f = indexValue(obj, n.name, n)
				if type(f) ~= "function" then rt(n, "'" .. n.name .. "' — не функция") end
				return callFn(f, { obj, table.unpack(args, 1, #n.args) }, #n.args + 1, n)
			elseif t == "Un" then
				local v = eval(n.e, scope)
				if n.op == "not" then return not truthy(v) end
				if n.op == "-" then
					local ok, r = pcall(function() return -v end)
					if not ok then rt(n, "нельзя взять минус от этого значения") end
					return r
				end
				if type(v) == "string" or type(v) == "table" then return #v end
				rt(n, "у этого значения нет длины")
			elseif t == "Bin" then
				local op = n.op
				if op == "and" then
					local a = eval(n.a, scope)
					if not truthy(a) then return a end
					return eval(n.b, scope)
				elseif op == "or" then
					local a = eval(n.a, scope)
					if truthy(a) then return a end
					return eval(n.b, scope)
				end
				local a, b = eval(n.a, scope), eval(n.b, scope)
				local ok, r = pcall(BINFN[op], a, b)
				if not ok then rt(n, "нельзя выполнить '" .. op .. "' для " .. typeof(a) .. " и " .. typeof(b)) end
				return r
			end
			rt(n, "неизвестный узел " .. tostring(t))
		end

		execBlock = function(stmts, scope)
			for i = 1, #stmts do
				local sig, val = exec(stmts[i], scope)
				if sig then return sig, val end
			end
			return nil
		end

		exec = function(s, scope)
			tick(s)
			local t = s.t
			if t == "ExprStat" then
				eval(s.e, scope)
			elseif t == "Local" then
				local vals = {}
				for i = 1, #s.exprs do vals[i] = eval(s.exprs[i], scope) end
				for i, name in ipairs(s.names) do declare(scope, name, vals[i]) end
			elseif t == "LocalFunc" then
				declare(scope, s.name, nil)
				scope.v[s.name] = makeFunc(s.f, scope)
			elseif t == "Assign" then
				local vals = {}
				for i = 1, #s.exprs do vals[i] = eval(s.exprs[i], scope) end
				for i, tg in ipairs(s.targets) do
					if tg.t == "Var" then
						setVar(scope, tg.name, vals[i])
					else
						setIndex(eval(tg.obj, scope), eval(tg.key, scope), vals[i], tg)
					end
				end
			elseif t == "If" then
				for _, c in ipairs(s.clauses) do
					if truthy(eval(c.cond, scope)) then
						return execBlock(c.body, newScope(scope))
					end
				end
				if s.elseBody then return execBlock(s.elseBody, newScope(scope)) end
			elseif t == "While" then
				while truthy(eval(s.cond, scope)) do
					tick(s)
					local sig, val = execBlock(s.body, newScope(scope))
					if sig == "break" then break end
					if sig == "return" then return sig, val end
				end
			elseif t == "NumFor" then
				local a, b = eval(s.a, scope), eval(s.b, scope)
				local c = 1
				if s.c then c = eval(s.c, scope) end
				if type(a) ~= "number" or type(b) ~= "number" or type(c) ~= "number" then
					rt(s, "в цикле for нужны числа")
				end
				if c == 0 then rt(s, "шаг цикла не может быть 0") end
				local i = a
				while (c > 0 and i <= b) or (c < 0 and i >= b) do
					tick(s)
					local ls = newScope(scope)
					declare(ls, s.var, i)
					local sig, val = execBlock(s.body, ls)
					if sig == "break" then break end
					if sig == "return" then return sig, val end
					i += c
				end
			elseif t == "GenFor" then
				local it = eval(s.e, scope)
				local list
				if type(it) == "table" and it.__liza_iter then
					list = it.items
				else
					rt(s, "for ... in ждёт pairs(таблица) или ipairs(таблица)")
				end
				for _, kv in ipairs(list) do
					tick(s)
					local ls = newScope(scope)
					declare(ls, s.names[1], kv[1])
					if s.names[2] then declare(ls, s.names[2], kv[2]) end
					local sig, val = execBlock(s.body, ls)
					if sig == "break" then break end
					if sig == "return" then return sig, val end
				end
			elseif t == "Return" then
				local v
				if s.e then v = eval(s.e, scope) end
				return "return", v
			elseif t == "Break" then
				return "break"
			elseif t == "Do" then
				return execBlock(s.body, newScope(scope))
			end
			return nil
		end

		execBlock(ast, newScope(nil))
	end
end

