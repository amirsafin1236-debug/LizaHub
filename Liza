			num("tint", "Сила цвета экрана", 0, 1, 0.35, 0.05, 1),
		},
		start = function(cfg)
			local char, root, hum = player.Character, getRoot(), getHum()
			if not (char and root and hum) then return nil end

			local folder = create("Folder", { Name = "LizaDisco" }, workspace)
			local ball = create("Part", {
				Name = "Ball", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2),
				Material = Enum.Material.Neon, Anchored = true, CanCollide = false,
				CanQuery = false, CanTouch = false, CastShadow = false,
			}, folder)
			local light = create("PointLight", { Shadows = false }, ball)
			local sparks = create("ParticleEmitter", {
				Rate = 0,
				Lifetime = NumberRange.new(0.6, 1.1),
				Speed = NumberRange.new(8, 16),
				SpreadAngle = Vector2.new(180, 180),
				LightEmission = 1,
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
				Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
			}, ball)
			local cc = create("ColorCorrectionEffect", { Name = "LizaDiscoCC", TintColor = WHITE }, Lighting)

			local oldAuto = hum.AutoRotate
			local conn = RS.RenderStepped:Connect(function(dt)
				if not root.Parent then return end
				local t = os.clock()
				local k = (t * cfg.cspeed) % 3
				local i = math.floor(k)
				local cols = { cfg.c1, cfg.c2, cfg.c3 }
				local col1 = cols[i + 1]
				local col2 = cols[(i + 1) % 3 + 1]
				local c = col1:Lerp(col2, k - i)

				light.Color = c
				light.Brightness = cfg.bright
				light.Range = cfg.range
				ball.Color = c
				ball.Transparency = cfg.ball and 0 or 1
				ball.CFrame = root.CFrame * CFrame.new(0, 4.6, 0) * CFrame.Angles(0, t * 2, 0)
				sparks.Rate = cfg.sparks and 40 or 0
				sparks.Color = ColorSequence.new(c)
				cc.Enabled = cfg.screen
				cc.TintColor = WHITE:Lerp(c, cfg.tint)

				if cfg.spin ~= 0 then
					hum.AutoRotate = false
					root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(cfg.spin) * dt, 0)
				else
					hum.AutoRotate = oldAuto
				end
			end)
			return function()
				conn:Disconnect()
				folder:Destroy()
				cc:Destroy()
				if hum.Parent then hum.AutoRotate = oldAuto end
			end
