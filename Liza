local toolNameBox = textBox(itemsPage, "My Tool", "My Tool")

local function finalToolName()
    local name = toolNameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    name = name:gsub("%s*%(LizaHub%)%s*$", "")
    if name == "" then name = "LizaHub Tool" end
    return name .. " (LizaHub)"
end

local function runMode(mode)
    local root = getRoot()
    local target = getTargetPosition()
    if not root or not target then return end

    if mode == "TP" then
        root.CFrame = CFrame.new(target + Vector3.new(0, 3, 0))
        return
    end

    if mode == "Place" then
        local part = makeObjectPart(
            "LizaHubCustomObject",
            target + Vector3.new(0, 1.5, 0),
            true
        )
        part.Parent = workspace
        trackObject(part)
        return
    end

    if mode == "Throw" then
        local spawnPosition =
            root.Position + root.CFrame.LookVector * 4
            + Vector3.new(0, 2, 0)

        local part = makeObjectPart(
            "LizaHubThrownObject", spawnPosition, false
        )
        part.Parent = workspace

        local offset = target - spawnPosition
        local direction = offset.Magnitude > 0
            and offset.Unit or root.CFrame.LookVector

        part.AssemblyLinearVelocity =
            direction * 90 + Vector3.new(0, 15, 0)

        trackObject(part)
    end
end

button(itemsPage, "Run Selected Mode", function()
    runMode(selectedMode)
end)

button(itemsPage, "Give Tool", function()
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not backpack then return end

    local tool = Instance.new("Tool")
    tool.Name = finalToolName()
    tool.RequiresHandle = true
    tool.CanBeDropped = true

    local handle = makeObjectPart("Handle", Vector3.zero, false)
    handle.Size = Vector3.new(1, 1, 1)
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool

    tool.Activated:Connect(function()
        runMode(selectedMode)
    end)

    tool.Parent = backpack

    local h = getHumanoid()
    if h then h:EquipTool(tool) end
end)

button(itemsPage, "Delete My Objects", function()
