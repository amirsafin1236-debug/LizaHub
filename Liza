local function trackObject(object)
    table.insert(customObjects, object)
end

local function getTargetPosition()
    local camera = workspace.CurrentCamera
    if not camera then return nil end

    local mouseLocation = UIS:GetMouseLocation()
    local ray = camera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {getCharacter()}

    local result = workspace:Raycast(ray.Origin, ray.Direction * 500, params)
    if result then return result.Position end
    return ray.Origin + ray.Direction * 30
end

local function makeObjectPart(position)
    local part = Instance.new("Part")
    part.Name = "LizaHubObject"
    part.Size = Vector3.new(2, 2, 2)
    part.Material = Enum.Material.Neon
    part.Color = ACCENT
    part.Anchored = objectMode == "Place"
    part.CanCollide = true

    if objectShape == "Sphere" then
        part.Shape = Enum.PartType.Ball
    elseif objectShape == "Circle" then
        part.Shape = Enum.PartType.Cylinder
        part.Size = Vector3.new(0.5, 2, 2)
    end

    part.Position = position
    part.Parent = workspace
    trackObject(part)
    return part
end

