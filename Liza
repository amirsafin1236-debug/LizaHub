			local on = Vip.mode == mode
			b.BackgroundColor3 = on and accentBg() or Theme.Panel
			b.TextColor3 = on and WHITE or Theme.Text
		end)
		table.insert(vipTargets, { inst = b, want = function() return Vip.mode == mode end })
