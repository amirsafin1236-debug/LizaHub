local tabs = {}
local function addTab(name)
	local page = create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = #tabs == 0,
	}, Content)
	create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, page)
	create("UIPadding", {
		PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
	}, page)

	local btn = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 34),
		Text = name,
		TextSize = 16,
		BorderSizePixel = 0,
		AutoButtonColor = false,
	}, Tabs)
	bind(btn, "Font", "Font")
	bind(btn, "TextColor3", "Text")
	corner(btn)
	fx(btn)

	local tab = { btn = btn, page = page }
	table.insert(tabs, tab)
	onTheme(btn, function()
		btn.BackgroundColor3 = page.Visible and accentBg() or Theme.Panel
	end)
	table.insert(vipTargets, { inst = btn, want = function() return page.Visible end })

	btn.Activated:Connect(function()
		for _, t in ipairs(tabs) do
			local active = (t == tab)
			t.page.Visible = active
			tw(t.btn, 0.2, { BackgroundColor3 = active and accentBg() or Theme.Panel })
		end
		page.Position = UDim2.fromOffset(24, 0)
		twA("tab", page, { Position = UDim2.fromOffset(0, 0) })
	end)
	return page
end

