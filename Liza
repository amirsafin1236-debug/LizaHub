	local ORANGE, RED = Color3.fromRGB(217, 119, 87), Color3.fromRGB(235, 70, 80)
	local function bars(parent, color, rots, w)
		for _, r in ipairs(rots) do
			local f = create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(w, 1),
				Rotation = r,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
			}, parent)
			create("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
		end
	end

	local bestScore = 0
	local function openClaudeGame()
		local p = showPopup(340, 300, "Claude · Лови идеи")
		local alive, running = true, false
		p.Destroying:Connect(function() alive, running = false, false end)
		local score, combo, timeLeft = 0, 0, 30
		local AW, AH = 316, 186

		local hud = create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 40),
			Size = UDim2.new(1, -28, 0, 22),
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = "",
		}, p)
		bind(hud, "TextColor3", "Text")
		bind(hud, "Font", "Font")
		local function refresh()
			hud.Text = string.format("Счёт %d · Комбо x%d · %d с · Рекорд %d", score, combo, math.max(0, math.ceil(timeLeft)), bestScore)
		end
		refresh()

		local area = create("Frame", {
			Position = UDim2.fromOffset(12, 66),
			Size = UDim2.fromOffset(AW, AH),
			BorderSizePixel = 0,
			ClipsDescendants = true,
		}, p)
		bind(area, "BackgroundColor3", "Panel")
		corner(area)

		local flash = create("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = RED,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 6,
		}, area)

		local msg = create("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.3),
			Size = UDim2.new(1, -20, 0, 50),
			BackgroundTransparency = 1,
			TextWrapped = true,
			TextSize = 17,
			Text = "Лови идеи (оранжевые звёзды)\nи обходи баги (красные крестики)",
			ZIndex = 4,
		}, area)
		bind(msg, "TextColor3", "Text")
		bind(msg, "Font", "Font")

		local startGame
		local startBtn = button(area, "Играть", function() startGame() end)
		startBtn.AnchorPoint = Vector2.new(0.5, 0.5)
		startBtn.Position = UDim2.fromScale(0.5, 0.68)
		startBtn.Size = UDim2.fromOffset(140, 34)
		startBtn.ZIndex = 4

		local hint = create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(14, 258),
			Size = UDim2.new(1, -28, 0, 34),
			TextWrapped = true,
			TextSize = 13,
			TextTransparency = 0.25,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Text = "Звезда: +1 (комбо даёт бонус). Баг: −2. 30 секунд, дальше быстрее.",
		}, p)
		bind(hint, "TextColor3", "Text")
		bind(hint, "Font", "Font")

		local function pop(b, txt, color)
			local l = create("TextLabel", {
				BackgroundTransparency = 1,
				Position = b.Position,
				Size = b.Size,
				Text = txt,
				TextSize = 22,
				TextColor3 = color,
				Font = Enum.Font.GothamBold,
				TextStrokeTransparency = 0.5,
				ZIndex = 5,
			}, area)
			tw(l, 0.6, { Position = b.Position - UDim2.fromOffset(0, 30), TextTransparency = 1, TextStrokeTransparency = 1 })
			Debris:AddItem(l, 0.7)
		end

		local function spawnTarget(prog)
			local bug = math.random() < 0.18 + 0.14 * prog
			local size = math.floor(50 - 20 * prog)
			local life = 1.4 - 0.7 * prog
			local b = create("TextButton", {
				Name = "T",
				Size = UDim2.fromOffset(size, size),
				Position = UDim2.fromOffset(math.random(0, AW - size), math.random(0, AH - size)),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
			}, area)
			local sc = create("UIScale", { Scale = 0.01 }, b)
			if bug then bars(b, RED, { 45, -45 }, 0.22) else bars(b, ORANGE, { 0, 60, 120 }, 0.2) end
			tw(sc, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)

			local done = false
			local function vanish()
				tw(sc, 0.12, { Scale = 0.01 })
				Debris:AddItem(b, 0.2)
			end
			b.Activated:Connect(function()
				if done or not running then return end
				done = true
				if bug then
					score = math.max(0, score - 2)
					combo = 0
					pop(b, "-2", RED)
					flash.BackgroundTransparency = 0.6
					tw(flash, 0.3, { BackgroundTransparency = 1 })
				else
					local gain = 1 + math.floor(combo / 5)
					combo += 1
					score += gain
					pop(b, "+" .. gain, ORANGE)
				end
				vanish()
				refresh()
			end)
			task.delay(life, function()
				if done or not b.Parent then return end
				done = true
				if not bug then combo = 0 end
				vanish()
			end)
		end

		startGame = function()
			if running then return end
			running, score, combo, timeLeft = true, 0, 0, 30
			startBtn.Visible, msg.Visible = false, false
			refresh()
			task.spawn(function()
				local acc, last = 0, os.clock()
				while alive and running and timeLeft > 0 do
					task.wait(0.05)
					local now = os.clock()
					local dt = now - last
					last = now
					timeLeft -= dt
					acc += dt
					local prog = math.clamp(1 - timeLeft / 30, 0, 1)
					if acc >= 0.75 - 0.45 * prog then
						acc = 0
						spawnTarget(prog)
					end
					refresh()
				end
				running = false
				if not alive then return end
				for _, c in ipairs(area:GetChildren()) do
					if c.Name == "T" then c:Destroy() end
				end
				local rec = score > bestScore
				if rec then bestScore = score end
				timeLeft = 0
				refresh()
				msg.Text = "Счёт: " .. score .. (rec and "\nНовый рекорд!" or "")
				msg.Visible = true
				startBtn.Text = "Ещё раз"
				startBtn.Visible = true
			end)
		end
	end

