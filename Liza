local function setPalettePosition(x, y, hueOnly)
    if hueOnly then
        paletteHue = math.clamp(
            (x - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1),
            0, 1
        )
    else
        paletteSat = math.clamp(
            (x - palette.AbsolutePosition.X) / math.max(palette.AbsoluteSize.X, 1),
            0, 1
        )
        paletteVal = 1 - math.clamp(
            (y - palette.AbsolutePosition.Y) / math.max(palette.AbsoluteSize.Y, 1),
            0, 1
        )
    end
    applyPalette()
end

