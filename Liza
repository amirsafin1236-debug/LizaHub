-- MOVEMENT

label(movementPage, "MOVEMENT")
button(movementPage, "Toggle Fly", function()
    flying = not flying

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    local root = getRoot()
    if not flying or not root then
        local h = getHumanoid()
        if h then h.PlatformStand = false end
        return
    end

    flyConnection = RunService.RenderStepped:Connect(function()
        local r = getRoot()
        local camera = workspace.CurrentCamera
        if not flying or not r or not camera then return end

        local direction = Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then
            direction += camera.CFrame.LookVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.S) then
            direction -= camera.CFrame.LookVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.A) then
            direction -= camera.CFrame.RightVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.D) then
            direction += camera.CFrame.RightVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.yAxis
        end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.yAxis
        end

        r.AssemblyLinearVelocity =
            direction.Magnitude > 0 and direction.Unit * flySpeed
            or Vector3.zero
    end)
end)

button(movementPage, "Fly Speed +20", function()
    flySpeed = math.clamp(flySpeed + 20, 20, 200)
end)

button(movementPage, "Fly Speed -20", function()
