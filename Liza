local function makeObjectPart(name, position, anchored)
	local part = Instance.new("Part")
	part.Name = name or "LizaHubCustomObject"
	part.Size = objectShape == "Sphere" and Vector3.new(2, 2, 2)
		or (objectShape == "Circle" and Vector3.new(3, 0.45, 3) or Vector3.new(2.5, 2.5, 2.5))
	part.Shape = objectShape == "Sphere" and Enum.PartType.Ball
		or (objectShape == "Circle" and Enum.PartType.Cylinder or Enum.PartType.Block)
	part.Material = Enum.Material.SmoothPlastic
	part.Color = ACCENT
	part.Anchored = anchored
	part.CanCollide = true
	part.Position = position
	return part
end

local function createCustomObject(position)
	local part = makeObjectPart("LizaHubCustomObject", position, true)
	part.Parent = workspace
	table.insert(customObjects, part)
	registerRGB(part)
	return part
end

local function makeHeldTool()
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack")
	local tool = Instance.new("Tool")
	tool.Name = "LizaHub " .. objectShape
	tool.RequiresHandle = true
	tool.CanBeDropped = true

	local handle = makeObjectPart("Handle", Vector3.zero, false)
	handle.Size = objectShape == "Sphere" and Vector3.new(1.1, 1.1, 1.1)
		or (objectShape == "Circle" and Vector3.new(1.2, 0.22, 1.2) or Vector3.new(0.9, 0.9, 0.9))
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool
	tool.Parent = backpack

	tool.Activated:Connect(function()
		local root = getRoot()
		local camera = workspace.CurrentCamera
		if not root or not camera or not tool.Parent then return end

		local target = getTargetPosition()
		local spawnPosition = root.Position + camera.CFrame.LookVector * 3 + Vector3.new(0, 1.5, 0)
		local projectile = makeObjectPart("LizaHubThrownObject", spawnPosition, false)
		projectile.Parent = workspace

		local offset = target and (target - spawnPosition) or camera.CFrame.LookVector
		local direction = offset.Magnitude > 0 and offset.Unit or camera.CFrame.LookVector
		projectile.AssemblyLinearVelocity = direction * 90 + Vector3.new(0, 12, 0)
		projectile.AssemblyAngularVelocity = Vector3.new(math.random(-12, 12), math.random(-12, 12), math.random(-12, 12))

		table.insert(customObjects, projectile)
		registerRGB(projectile)
	end)
end

button(itemsPage, "Create Held Tool", makeHeldTool)

