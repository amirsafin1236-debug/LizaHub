local function applyConfig(config)
    if not config then return end

    HUB_NAME = config.title or HUB_NAME
    BACKGROUND = config.background or BACKGROUND
    BACKGROUND_IMAGE = config.backgroundImage or ""
    MENU_SCALE = config.scale or MENU_SCALE
    autoLoadConfig = config.autoLoad or false

    titleLabel.Text = HUB_NAME
    titleBox.Text = HUB_NAME
    main.BackgroundColor3 = BACKGROUND
    backgroundImage.Image = BACKGROUND_IMAGE
    backgroundImage.Visible = BACKGROUND_IMAGE ~= ""

    updateAccent(config.accent or ACCENT)
    fitScreen()

    if config.selectedTab and pages[config.selectedTab] then
        selectTab(config.selectedTab)
    end

    if autoLoadButton then
        autoLoadButton.Text = autoLoadConfig and "Auto Load Config: ON" or "Auto Load Config: OFF"
    end
end

