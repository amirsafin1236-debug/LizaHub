local function updateAccent(color)
	ACCENT = color
	title.TextColor3 = color
	mainStroke.Color = color

	for tabName, tabButton in pairs(tabButtons) do
		if tabName == currentTab then
			tabButton.BackgroundColor3 = color
		end
	end

	for _, object in ipairs(gui:GetDescendants()) do
		if object:IsA("ScrollingFrame") then
			object.ScrollBarImageColor3 = color
		elseif object:IsA("TextLabel") and object.TextColor3 == Color3.fromRGB(255, 132, 35) then
			object.TextColor3 = color
		elseif object:IsA("TextButton") and (object.Text == "UP" or object.Text == "DOWN") then
			object.BackgroundColor3 = color
		elseif object:IsA("Frame") and object.Name == "Fill" then
			object.BackgroundColor3 = color
		end
	end
end

