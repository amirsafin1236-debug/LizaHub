local openVipCustom
openVipCustom = function()
	local p = showPopup(340, 288, "Кастом")
	local sc = popupList(p)

	local pv = create("Frame", { Size = UDim2.new(1, 0, 0, 22), BorderSizePixel = 0, BackgroundColor3 = WHITE }, sc)
	corner(pv)
	Vip.preview = create("UIGradient", {}, pv)

	slider(sc, "Скорость переливания", 0, 3, Vip.speed, 0.05, 20, function(v) Vip.speed = v end)
	note(sc, "Таймлайн 0.0 – 1.0: где на кнопке стоит каждый цвет. Скорость 0 — все цвета просто помещаются в кнопку.")

	local holder = create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, sc)
	create("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, holder)

	local function rebuild()
		for _, c in ipairs(holder:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		for i, st in ipairs(Vip.stops) do
			local row = create("Frame", { Size = UDim2.new(1, 0, 0, 38), BorderSizePixel = 0, LayoutOrder = i }, holder)
			bind(row, "BackgroundColor3", "Panel")
			corner(row)

			local lbl = create("TextLabel", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.fromOffset(60, 38),
				Text = "Цвет " .. i,
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, row)
			bind(lbl, "TextColor3", "Text")
			bind(lbl, "Font", "Font")

			local tbox = create("TextBox", {
				Position = UDim2.fromOffset(74, 6),
				Size = UDim2.fromOffset(60, 26),
				Text = string.format("%.2f", st.t),
				TextSize = 14,
				ClearTextOnFocus = false,
				BorderSizePixel = 0,
			}, row)
			bind(tbox, "BackgroundColor3", "Bg")
			bind(tbox, "TextColor3", "Text")
			bind(tbox, "Font", "Font")
			corner(tbox)
			tbox.FocusLost:Connect(function()
				local n = tonumber(tbox.Text)
				if n then st.t = math.floor(math.clamp(n, 0, 1) * 100 + 0.5) / 100 end
				tbox.Text = string.format("%.2f", st.t)
			end)

			local sw = create("TextButton", {
				Position = UDim2.fromOffset(142, 6),
				Size = UDim2.new(1, -142 - 44, 0, 26),
				Text = "",
				BorderSizePixel = 0,
				AutoButtonColor = false,
				BackgroundColor3 = st.c,
			}, row)
			create("UICorner", { CornerRadius = UDim.new(0, 6) }, sw)
			create("UIStroke", { Color = Color3.fromRGB(140, 140, 140), Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, sw)
			sw.Activated:Connect(function()
				pickColor("Цвет " .. i, st.c, function(c) st.c = c end, openVipCustom)
			end)

			local del = create("TextButton", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.fromOffset(28, 26),
				Text = "✕",
				TextSize = 14,
				TextColor3 = WHITE,
				BorderSizePixel = 0,
				BackgroundColor3 = Color3.fromRGB(200, 60, 70),
				BackgroundTransparency = #Vip.stops <= 2 and 0.65 or 0,
			}, row)
			create("UICorner", { CornerRadius = UDim.new(0, 6) }, del)
			del.Activated:Connect(function()
				if #Vip.stops <= 2 then return end -- меньше 2 цветов нельзя
				table.remove(Vip.stops, i)
				rebuild()
			end)
		end
	end
	rebuild()

	button(sc, "+  Добавить цвет", function()
		if #Vip.stops >= 10 then return end
		local pts = { 0, 1 }
		for _, s in ipairs(Vip.stops) do table.insert(pts, s.t) end
		table.sort(pts)
		local bestGap, bestT = -1, 0.5
		for i = 1, #pts - 1 do
			local g = pts[i + 1] - pts[i]
			if g > bestGap then bestGap = g bestT = (pts[i] + pts[i + 1]) / 2 end
		end
		table.insert(Vip.stops, { t = math.floor(bestT * 100 + 0.5) / 100, c = Color3.fromHSV(math.random(), 0.9, 1) })
		rebuild()
	end)
end

local function openVip()
