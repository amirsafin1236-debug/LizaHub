		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 12,
		Font = Enum.Font.GothamSemibold,
		LayoutOrder = order,
		AutoButtonColor = false
	}, tabList)

	corner(tabButton, 7)
	tabButtons[name] = tabButton

	tabButton.Activated:Connect(function()
		selectTab(name)
	end)

	return createPage(name)
end

