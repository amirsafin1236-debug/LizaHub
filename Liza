local function openThemeList()
	local items = {}
	for _, t in ipairs(BuiltIn) do
		table.insert(items, {
			text = t.text, name = t.text, theme = t.theme,
			colors = { t.theme.Accent, t.theme.Bg, t.theme.Panel },
			selected = currentThemeName == t.text,
		})
	end
	for _, t in ipairs(CustomThemes) do
		table.insert(items, {
			text = "★ " .. t.text, name = t.text, theme = t.theme,
			colors = { t.theme.Accent, t.theme.Bg, t.theme.Panel },
			selected = currentThemeName == t.text,
			onDelete = function()
				table.remove(CustomThemes, table.find(CustomThemes, t))
				openThemeList()
			end,
		})
	end
	openList("Выбрать тему", items, function(it)
		currentThemeName = it.name
		Vip.saved = nil
		tweenTheme(it.theme)
		closePopup()
	end)
end

local function openFontList()
	local items = {}
	for _, f in ipairs(FontList) do
		table.insert(items, { text = f.Name, font = f, selected = Theme.Font == f })
	end
	openList("Шрифт", items, function(it)
		Theme.Font = it.font
		applyTheme()
		closePopup()
	end)
end

